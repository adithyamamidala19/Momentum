# ==============================================================================
# Momentum Backend API Server - Environment Variables
# Copy this file to .env and provide your production/staging secrets.
# NEVER commit the real .env file into version control.
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String (Atlas or local replica set)
# e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/momentum?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/momentum

# Client Origins for CORS (comma-separated allowlist of allowed frontend origins)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173

# Firebase Admin SDK Credentials (from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=momentum-mindful-sanctuary
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@momentum-mindful-sanctuary.iam.gserviceaccount.com
# Note: For private key, preserve standard escaped newlines \n or wrap in quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC7...==\n-----END PRIVATE KEY-----\n"

# Session Cookie Configuration
SESSION_COOKIE_NAME=__session
SESSION_MAX_AGE_DAYS=14
# COOKIE_DOMAIN: leave empty in development or set to your root domain in production (e.g. .momentum.app)
COOKIE_DOMAIN=

# AI Food Vision / Caloric Analysis Provider Key (Server-Only, never exposed to client)
GEMINI_API_KEY=AIzaSyYourServerSideGeminiApiKeyHere

# Optional: Sentry DSN for server-side error monitoring
SENTRY_DSN=
