# ==============================================================================
# Momentum Client - Environment Variables
# Copy this file to .env and provide your client-side public Firebase configuration.
# NEVER commit the real .env file into version control.
# ==============================================================================

# Backend API Base URL (with trailing /api or origin)
# In development, leave as /api when using Vite proxy or set full URL
REACT_APP_API_BASE_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# Firebase Web App Public Configuration (from Firebase Console > Project Settings > General > Your Apps)
# These public keys identify your Firebase project to the Google Identity SDK.
REACT_APP_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere

REACT_APP_FIREBASE_AUTH_DOMAIN=momentum-mindful-sanctuary.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=momentum-mindful-sanctuary.firebaseapp.com

REACT_APP_FIREBASE_PROJECT_ID=momentum-mindful-sanctuary
VITE_FIREBASE_PROJECT_ID=momentum-mindful-sanctuary

REACT_APP_FIREBASE_STORAGE_BUCKET=momentum-mindful-sanctuary.firebasestorage.app
VITE_FIREBASE_STORAGE_BUCKET=momentum-mindful-sanctuary.firebasestorage.app

REACT_APP_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Sentry DSN for frontend error monitoring (disabled if empty)
REACT_APP_SENTRY_DSN=
VITE_SENTRY_DSN=

# Database Connection (Configure in server/.env)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/momentum?retryWrites=true&w=majority
