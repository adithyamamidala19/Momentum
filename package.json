{
  "name": "momentum-mindful-habits",
  "version": "1.0.0",
  "description": "Momentum — Mindful habit tracking and daily rhythm sanctuary with meditative soundscapes, smart reminders, and grounded AI assistant.",
  "type": "module",
  "scripts": {
    "start": "npm --prefix frontend start",
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "server": "npm --prefix backend start",
    "server:dev": "npm --prefix backend run dev",
    "db:indexes": "npm --prefix backend run create-indexes",
    "db:seed": "npm --prefix backend run seed -- --allow-dev-seed",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "npm --prefix frontend test && npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "lint": "npm --prefix frontend run lint",
    "format": "npx prettier --write \"**/*.{html,css,js,jsx,json,md}\"",
    "deploy": "npm --prefix frontend run build && firebase deploy"
  },
  "keywords": [
    "habit-tracker",
    "mindfulness",
    "vanilla-js",
    "es-modules",
    "web-audio",
    "tailwind",
    "firebase"
  ],
  "author": "Adithya Mamidala",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "serve": "^14.2.4"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "canvas-confetti": "^1.9.4",
    "firebase": "^11.10.0",
    "framer-motion": "^13.4.1",
    "html-to-image": "^1.11.13",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "postcss": "^8.4.47",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^3.4.13",
    "three": "^0.186.0",
    "vite": "^8.3.0"
  }
}
