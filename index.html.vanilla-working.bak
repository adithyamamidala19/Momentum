<!-- ─────────────────────────────────────────────────────── -->
<!-- VIEW: LOGIN / SYSTEMATIC ACCOUNT SETUP                  -->
<!-- ─────────────────────────────────────────────────────── -->
<div id="view-login" class="view" role="main">
  <div class="preauth-wrap" style="max-width:440px">
    <div class="w-full flex items-center justify-between pt-2 mb-2">
      <button onclick="navigate('welcome')" class="flex items-center gap-1 text-xs text-outline hover:text-on-surface transition-colors cursor-pointer border-0 bg-transparent">
        <span class="material-symbols-outlined text-[16px]">arrow_back</span>
        <span>Back</span>
      </button>
      <div class="flex items-center gap-1.5 opacity-60">
        <span class="text-xs tracking-wider uppercase font-medium text-outline">Momentum</span>
      </div>
    </div>

    <main class="w-full my-auto flex flex-col items-center text-center py-4">
      
      <!-- Mindful Sanctuary Icon -->
      <div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center mb-4 text-primary-container leaf-enter shadow-sm">
        <span id="auth-header-icon" class="material-symbols-outlined text-[26px]">spa</span>
      </div>

      <!-- Tab Switcher: Sign In vs Create Account -->
      <div class="w-full flex p-1 rounded-2xl bg-surface-container-low mb-5 hairline">
        <button type="button" id="tab-btn-signin" onclick="switchAuthTab('signIn')" class="flex-1 py-2.5 rounded-xl text-xs font-semibold transition-all cursor-pointer border-0 bg-surface-container-lowest text-on-surface shadow-xs flex items-center justify-center gap-1.5">
          <span class="material-symbols-outlined text-[16px]">login</span>
          <span>Sign In</span>
        </button>
        <button type="button" id="tab-btn-signup" onclick="switchAuthTab('signUp')" class="flex-1 py-2.5 rounded-xl text-xs font-semibold transition-all cursor-pointer border-0 bg-transparent text-outline hover:text-on-surface flex items-center justify-center gap-1.5">
          <span class="material-symbols-outlined text-[16px]">person_add</span>
          <span>Create Account</span>
        </button>
      </div>

      <!-- Dynamic Titles -->
      <h1 id="auth-card-title" class="font-editorial text-2xl sm:text-3xl text-on-surface font-normal tracking-tight mb-1.5">Welcome back</h1>
      <p id="auth-card-subtitle" class="text-xs sm:text-[0.875rem] leading-relaxed text-outline max-w-[340px] font-normal mb-5">
        Sign in with your email to load your personalized rituals and sync your progress.
      </p>

      <!-- Inline Feedback / Error Box -->
      <div id="auth-inline-feedback" class="hidden w-full p-3.5 rounded-xl text-xs flex items-start gap-2.5 mb-4 text-left transition-all">
        <span id="auth-feedback-icon" class="material-symbols-outlined text-[18px] shrink-0 mt-0.5">info</span>
        <div class="flex-1">
          <p id="auth-feedback-msg" class="leading-relaxed"></p>
        </div>
      </div>

      <!-- Auth Form -->
      <form class="w-full space-y-3.5 text-left" onsubmit="submitLogin(event)">
        
        <!-- Full Name (Visible in Register Mode) -->
        <div id="auth-name-wrapper" class="hidden">
          <label for="login-name" class="block text-xs font-medium text-on-surface-variant mb-1">Your Name</label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-outline text-[18px]">person</span>
            <input type="text" id="login-name" name="name" placeholder="e.g. Adithya Mamidala" autocomplete="name"
              class="w-full pl-10 pr-4 py-3 rounded-xl bg-surface-container-lowest hairline text-[0.9375rem] text-on-surface placeholder:text-outline/60 focus:outline-none focus:ring-1 focus:ring-primary-container transition-all">
          </div>
        </div>

        <!-- Email Address -->
        <div>
          <label for="login-email" class="block text-xs font-medium text-on-surface-variant mb-1">Email address</label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-outline text-[18px]">mail</span>
            <input type="email" id="login-email" name="email" placeholder="name@example.com" required autocomplete="email"
              class="w-full pl-10 pr-4 py-3 rounded-xl bg-surface-container-lowest hairline text-[0.9375rem] text-on-surface placeholder:text-outline/60 focus:outline-none focus:ring-1 focus:ring-primary-container transition-all">
          </div>
        </div>

        <!-- Password -->
        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="login-password" class="block text-xs font-medium text-on-surface-variant">Password</label>
            <button type="button" id="auth-forgot-pass-btn" onclick="openForgotPasswordModal()" class="text-[11px] text-primary-container font-medium hover:underline cursor-pointer border-0 bg-transparent">Forgot password?</button>
          </div>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-outline text-[18px]">lock</span>
            <input type="password" id="login-password" name="password" placeholder="••••••••" required autocomplete="current-password" minlength="6"
              class="w-full pl-10 pr-11 py-3 rounded-xl bg-surface-container-lowest hairline text-[0.9375rem] text-on-surface placeholder:text-outline/60 focus:outline-none focus:ring-1 focus:ring-primary-container transition-all">
            <button type="button" onclick="togglePasswordVisibility('login-password', 'btn-pass-toggle-icon')" class="absolute right-3 text-outline hover:text-on-surface transition-colors cursor-pointer border-0 bg-transparent p-1" title="Toggle password visibility">
              <span id="btn-pass-toggle-icon" class="material-symbols-outlined text-[18px]">visibility</span>
            </button>
          </div>
        </div>

        <!-- Confirm Password (Visible in Register Mode) -->
        <div id="auth-confirm-pass-wrapper" class="hidden">
          <label for="login-confirm-password" class="block text-xs font-medium text-on-surface-variant mb-1">Confirm Password</label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-outline text-[18px]">lock_reset</span>
            <input type="password" id="login-confirm-password" name="confirm_password" placeholder="••••••••" autocomplete="new-password" minlength="6"
              class="w-full pl-10 pr-11 py-3 rounded-xl bg-surface-container-lowest hairline text-[0.9375rem] text-on-surface placeholder:text-outline/60 focus:outline-none focus:ring-1 focus:ring-primary-container transition-all">
            <button type="button" onclick="togglePasswordVisibility('login-confirm-password', 'btn-confirm-pass-toggle-icon')" class="absolute right-3 text-outline hover:text-on-surface transition-colors cursor-pointer border-0 bg-transparent p-1" title="Toggle password visibility">
              <span id="btn-confirm-pass-toggle-icon" class="material-symbols-outlined text-[18px]">visibility</span>
            </button>
          </div>
        </div>

        <!-- Primary Submit Button -->
        <button type="submit" id="login-submit-btn" class="w-full mt-2 py-3.5 px-5 rounded-xl bg-primary-container hover:bg-primary active:scale-[0.99] text-on-primary text-[0.9375rem] font-medium transition duration-150 flex items-center justify-center gap-2 cursor-pointer shadow-sm">
          <span id="login-btn-text">Sign In &amp; Sync</span>
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </button>

        <!-- Divider -->
        <div class="flex items-center gap-2 my-2 opacity-50">
          <div class="h-px flex-1 bg-outline-variant"></div>
          <span class="text-[11px] uppercase tracking-wider text-outline font-medium">or continue with</span>
          <div class="h-px flex-1 bg-outline-variant"></div>
        </div>

        <!-- Google Sign-In Button -->
        <button type="button" onclick="signInWithGoogleFirebase()" class="w-full py-3 px-5 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-on-surface text-xs font-medium transition duration-150 flex items-center justify-center gap-2.5 cursor-pointer border border-outline-variant/50 shadow-2xs">
          <svg class="w-4 h-4" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Continue with Google</span>
        </button>

        <!-- 1-Click Instant Mindful Access -->
        <button type="button" onclick="instantLogin()" class="w-full py-2.5 px-5 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface text-xs font-medium transition duration-150 flex items-center justify-center gap-2 cursor-pointer border border-outline-variant/40">
          <span class="material-symbols-outlined text-[16px] text-primary">visibility</span>
          <span>Explore as Mindful Guest</span>
        </button>

        <!-- Firebase Config Settings Trigger -->
        <div class="pt-2 text-center">
          <button type="button" onclick="openFirebaseConfigModal()" class="text-[11px] text-outline hover:text-primary transition-colors cursor-pointer border-0 bg-transparent flex items-center justify-center gap-1 mx-auto">
            <span class="material-symbols-outlined text-[13px]">tune</span>
            <span>Firebase Cloud Settings</span>
          </button>
        </div>
      </form>
    </main>

    <footer class="w-full pt-3 pb-2 text-center">
      <p class="text-[11px] text-outline/80 leading-relaxed">
        Your data remains private, local-first and securely stored in Firebase.
      </p>
    </footer>
  </div>
</div>

<!-- ─────────────────────────────────────────────────────── -->
<!-- VIEW: OTP VERIFICATION                                  -->
<!-- ─────────────────────────────────────────────────────── -->
<div id="view-otp" class="view" role="main">
  <div class="preauth-wrap" style="max-width:400px">
    <div class="w-full flex items-center justify-between pt-2">
      <button onclick="navigate('login')" class="flex items-center gap-1 text-xs text-outline hover:text-on-surface transition-colors cursor-pointer border-0 bg-transparent">
        <span class="material-symbols-outlined text-[16px]">arrow_back</span>
        <span>Back</span>
      </button>
      <div class="flex items-center gap-1.5 opacity-60">
        <span class="text-xs tracking-wider uppercase font-medium text-outline">Momentum</span>
      </div>
    </div>

    <main class="w-full my-auto flex flex-col items-center text-center py-6">
      <div class="w-14 h-14 rounded-full bg-primary-fixed flex items-center justify-center mb-6 text-primary-container leaf-enter shadow-sm">
        <span class="material-symbols-outlined text-[26px]">mark_email_read</span>
      </div>

      <h1 class="font-editorial text-3xl text-on-surface font-normal tracking-tight mb-2">Check your device</h1>
      <p class="text-[0.9375rem] leading-relaxed text-outline max-w-[300px] font-normal mb-7">
        We sent a 6-digit verification code to <span id="otp-contact-display" class="font-medium text-on-surface">+1 (555) 234-5678</span>.
        <button onclick="navigate('login')" class="text-primary-container underline font-medium hover:text-primary ml-1 cursor-pointer border-0 bg-transparent text-xs">Edit</button>
      </p>

      <form class="w-full space-y-6" onsubmit="submitOtp(event)">
        <!-- 6-digit OTP Inputs -->
        <div class="flex items-center justify-center gap-2 sm:gap-2.5" id="otp-inputs-container">
          <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="otp-box w-11 h-13 text-center font-headline-md text-xl font-medium rounded-xl bg-surface-container-lowest hairline focus:outline-none focus:ring-2 focus:ring-primary-container text-on-surface transition-all" value="4" autofocus>
          <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="otp-box w-11 h-13 text-center font-headline-md text-xl font-medium rounded-xl bg-surface-container-lowest hairline focus:outline-none focus:ring-2 focus:ring-primary-container text-on-surface transition-all" value="8">
          <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="otp-box w-11 h-13 text-center font-headline-md text-xl font-medium rounded-xl bg-surface-container-lowest hairline focus:outline-none focus:ring-2 focus:ring-primary-container text-on-surface transition-all" value="2">
          <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="otp-box w-11 h-13 text-center font-headline-md text-xl font-medium rounded-xl bg-surface-container-lowest hairline focus:outline-none focus:ring-2 focus:ring-primary-container text-on-surface transition-all" value="9">
          <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="otp-box w-11 h-13 text-center font-headline-md text-xl font-medium rounded-xl bg-surface-container-lowest hairline focus:outline-none focus:ring-2 focus:ring-primary-container text-on-surface transition-all" value="1">
          <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="otp-box w-11 h-13 text-center font-headline-md text-xl font-medium rounded-xl bg-surface-container-lowest hairline focus:outline-none focus:ring-2 focus:ring-primary-container text-on-surface transition-all" value="7">
        </div>

        <button type="submit" id="otp-submit-btn" class="w-full py-3.5 px-5 rounded-xl bg-primary-container hover:bg-primary active:scale-[0.99] text-on-primary text-[0.9375rem] font-medium transition duration-150 flex items-center justify-center gap-2 cursor-pointer shadow-sm">
          <span>Verify &amp; Begin Rhythm</span>
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </button>

        <div class="text-xs text-outline pt-1">
          <span>Didn’t receive the code? </span>
          <button type="button" id="otp-resend-btn" onclick="resendOtp()" class="text-primary-container font-medium hover:underline cursor-pointer border-0 bg-transparent">
            Resend in <span id="otp-timer">24s</span>
          </button>
        </div>
      </form>
    </main>

    <footer class="w-full pt-4 pb-2 text-center">
      <p class="font-editorial italic text-xs text-outline tracking-wide">
        Your mindful journey unfolds today.
      </p>
    </footer>
  </div>
</div>

