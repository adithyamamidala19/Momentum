            🔥 Scoring all habits &amp; rituals
          </span>
        </div>
        <h1 class="font-display text-display text-on-surface tracking-tight">Your momentum arc</h1>
        <p class="font-body-md text-body-md text-on-surface-variant mt-space-xs">Real-time scoring across your starter rituals and custom daily habits.</p>
      </section>

      <!-- ⭐ UNIVERSAL SCORING BOARD HERO CARD ⭐ -->
      <section class="mb-space-xl">
        <div class="bg-surface-container-lowest rounded-2xl p-space-lg sm:p-8 shadow-sm hairline transition-all duration-300 relative overflow-hidden">
          <!-- Background decorative glow -->
          <div class="absolute -top-20 -right-20 w-64 h-64 bg-primary-fixed/30 rounded-full blur-3xl pointer-events-none"></div>

          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-lg relative z-10">
            <!-- Left: Big Score Counter & Highlights -->
            <div class="flex flex-col gap-2">
              <div class="flex items-baseline gap-space-md flex-wrap">
                <span id="insights-score-number" class="counter-number font-display text-[4rem] sm:text-[4.75rem] leading-none text-primary-container tracking-tight" data-target="92">92%</span>
                <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-primary-fixed text-primary font-medium text-xs shadow-xs">
                  <span class="material-symbols-outlined text-[16px] leading-none text-primary">trending_up</span>
                  <span id="insights-trend-label">+8% adherence vs last week</span>
                </div>
              </div>
              <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider font-semibold">Universal Habit &amp; Ritual Score</span>
              <p id="insights-habits-summary" class="font-body-md text-body-md text-on-surface-variant max-w-lg leading-relaxed mt-1">
                Scoring across all 4 active habits &amp; starter rituals · 24-day personal best · 100% morning presence maintained.
              </p>
            </div>

            <!-- Right: 3 Quick Metric Pills -->
            <div class="grid grid-cols-3 sm:grid-cols-3 gap-3 shrink-0">
              <div class="p-3.5 rounded-xl bg-surface-container-low text-center flex flex-col items-center justify-center min-w-[90px]">
                <span class="text-xs text-outline font-medium">Active Habits</span>
                <span id="insights-total-habits-count" class="counter-number font-headline-md text-headline-md font-bold text-on-surface mt-0.5" data-target="4">4</span>
                <span class="text-[10px] text-primary font-medium">All Scored</span>
              </div>
              <div class="p-3.5 rounded-xl bg-surface-container-low text-center flex flex-col items-center justify-center min-w-[90px]">
                <span class="text-xs text-outline font-medium">Current Flame</span>
                <span id="insights-streak-days" class="counter-number font-headline-md text-headline-md font-bold text-amber-600 mt-0.5" data-target="7">7</span>
                <span class="text-[10px] text-amber-600 font-medium">Days Fire</span>
              </div>
              <div class="p-3.5 rounded-xl bg-surface-container-low text-center flex flex-col items-center justify-center min-w-[90px]">
                <span class="text-xs text-outline font-medium">Total Logged</span>
                <span id="insights-total-rituals-completed" class="counter-number font-headline-md text-headline-md font-bold text-on-surface mt-0.5" data-target="98">98</span>
                <span class="text-[10px] text-outline">Sessions</span>
              </div>
            </div>
          </div>

          <!-- Category Scoring Breakdown Bars -->
          <div class="h-px bg-surface-container my-6"></div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div>
              <div class="flex justify-between items-center text-xs text-on-surface-variant mb-1">
                <span class="font-medium">🌿 Health &amp; Body</span>
                <span class="counter-number font-bold text-primary" data-target="96">96%</span>
              </div>
              <div class="w-full h-2 rounded-full bg-surface-container overflow-hidden">
                <div class="h-full bg-emerald-500 rounded-full transition-all duration-1000" style="width: 96%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between items-center text-xs text-on-surface-variant mb-1">
                <span class="font-medium">🧘 Mind &amp; Breath</span>
                <span class="counter-number font-bold text-primary" data-target="88">88%</span>
              </div>
              <div class="w-full h-2 rounded-full bg-surface-container overflow-hidden">
                <div class="h-full bg-teal-500 rounded-full transition-all duration-1000" style="width: 88%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between items-center text-xs text-on-surface-variant mb-1">
                <span class="font-medium">🎯 Deep Focus</span>
                <span class="counter-number font-bold text-primary" data-target="92">92%</span>
              </div>
              <div class="w-full h-2 rounded-full bg-surface-container overflow-hidden">
                <div class="h-full bg-indigo-500 rounded-full transition-all duration-1000" style="width: 92%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between items-center text-xs text-on-surface-variant mb-1">
                <span class="font-medium">🎨 Craft &amp; Creation</span>
                <span class="counter-number font-bold text-primary" data-target="85">85%</span>
              </div>
              <div class="w-full h-2 rounded-full bg-surface-container overflow-hidden">
                <div class="h-full bg-amber-500 rounded-full transition-all duration-1000" style="width: 85%"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ⭐ 1. PREMIER HABIT RHYTHM & FLOW GRAPH ANALYSIS ⭐ -->
      <section class="mb-space-xl">
        <div class="bg-surface-container-lowest rounded-2xl p-space-lg sm:p-8 shadow-sm hairline relative overflow-hidden">
          <!-- Ambient Glow -->
          <div class="absolute -top-16 -left-16 w-56 h-56 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

          <!-- Section Header & Active Day Inspector Pill -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm mb-6 relative z-10">
            <div>
              <div class="flex items-center gap-2">
                <h2 class="font-headline-sm text-headline-sm text-on-surface font-medium">Habit rhythm &amp; energy curve</h2>
                <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[11px] font-semibold border border-emerald-300/60">Live Reactive</span>
              </div>
              <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">Continuous daily habit execution trajectory across daylight rhythm</p>
            </div>
            <div id="graph-inspection-pill" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-primary-container text-on-primary font-medium text-xs shadow-sm transition-all duration-300">
              <span class="w-2 h-2 rounded-full bg-emerald-300 animate-pulse"></span>
              <span id="graph-inspection-text">Wed, Oct 24 (Today) · 100% Adherence (4/4 Done)</span>
            </div>
          </div>

          <!-- ⚡ Recharts Premium Chart Container -->
          <div class="relative w-full bg-surface-container-low/60 rounded-xl p-4 pt-2 hairline mb-6 overflow-hidden" style="min-height: 300px;">
            <!-- Habit Rhythm & Energy Curve Interactive SVG Chart -->
            <div id="habit-chart-shell" class="relative w-full select-none" style="min-height: 280px;">
              <!-- Interactive Legend Pills -->
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3 px-1 text-xs">
                <div class="flex flex-wrap items-center gap-2">
                  <button type="button" onclick="toggleHabitCurve('water')" id="legend-btn-water" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-700 font-medium text-[11px] border border-cyan-500/30 transition-all cursor-pointer">
                    <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                    <span>Morning Water</span>
                  </button>
                  <button type="button" onclick="toggleHabitCurve('breathing')" id="legend-btn-breathing" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-teal-500/10 hover:bg-teal-500/20 text-teal-700 font-medium text-[11px] border border-teal-500/30 transition-all cursor-pointer">
                    <span class="w-2 h-2 rounded-full bg-teal-500"></span>
                    <span>Box Breathing</span>
                  </button>
                  <button type="button" onclick="toggleHabitCurve('focus')" id="legend-btn-focus" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-indigo-500/10 hover:bg-indigo-500/20 text-indigo-700 font-medium text-[11px] border border-indigo-500/30 transition-all cursor-pointer">
                    <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                    <span>Deep Focus</span>
                  </button>
                  <button type="button" onclick="toggleHabitCurve('winddown')" id="legend-btn-winddown" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-700 font-medium text-[11px] border border-amber-500/30 transition-all cursor-pointer">
                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                    <span>Evening Wind-Down</span>
                  </button>
                </div>
                <div class="text-[11px] text-on-surface-variant flex items-center gap-1">
                  <span class="material-symbols-outlined text-[14px]">touch_app</span>
                  <span>Hover / touch to inspect curve</span>
                </div>
              </div>

              <!-- Interactive Floating Glassmorphism Tooltip -->
              <div id="habit-chart-tooltip" 
                   class="absolute pointer-events-none z-30 hidden bg-surface-container-lowest/95 backdrop-blur-md px-3.5 py-2.5 rounded-xl border border-outline-variant/30 shadow-xl transition-all duration-150 text-xs min-w-[190px]">
              </div>

              <!-- Main SVG Canvas -->
              <svg id="habit-chart-svg" class="w-full overflow-visible" style="height: 258px;" viewBox="0 0 800 258">
                <defs>
                  <linearGradient id="grad-water" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#0891b2" stop-opacity="0.32"/>
                    <stop offset="85%" stop-color="#0891b2" stop-opacity="0.04"/>
                    <stop offset="100%" stop-color="#0891b2" stop-opacity="0.0"/>
                  </linearGradient>
                  <linearGradient id="grad-breathing" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#0d9488" stop-opacity="0.32"/>
                    <stop offset="85%" stop-color="#0d9488" stop-opacity="0.04"/>
                    <stop offset="100%" stop-color="#0d9488" stop-opacity="0.0"/>
                  </linearGradient>
                  <linearGradient id="grad-focus" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#4f46e5" stop-opacity="0.32"/>
                    <stop offset="85%" stop-color="#4f46e5" stop-opacity="0.04"/>
                    <stop offset="100%" stop-color="#4f46e5" stop-opacity="0.0"/>
                  </linearGradient>
                  <linearGradient id="grad-winddown" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#d97706" stop-opacity="0.32"/>
                    <stop offset="85%" stop-color="#d97706" stop-opacity="0.04"/>
                    <stop offset="100%" stop-color="#d97706" stop-opacity="0.0"/>
                  </linearGradient>

                  <!-- Glow Filters -->
                  <filter id="glow-water" x="-20%" y="-20%" width="140%" height="140%">
                    <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#0891b2" flood-opacity="0.3"/>
                  </filter>
                  <filter id="glow-breathing" x="-20%" y="-20%" width="140%" height="140%">
                    <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#0d9488" flood-opacity="0.3"/>
                  </filter>
                  <filter id="glow-focus" x="-20%" y="-20%" width="140%" height="140%">
                    <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#4f46e5" flood-opacity="0.3"/>
                  </filter>
                  <filter id="glow-winddown" x="-20%" y="-20%" width="140%" height="140%">
                    <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#d97706" flood-opacity="0.3"/>
                  </filter>
                </defs>

                <!-- Grid & Axes Groups -->
                <g id="hc-grid"></g>
                <g id="hc-yaxis"></g>
                <g id="hc-xaxis"></g>

                <!-- Habit Gradient Area Waves -->
                <path id="hc-area-winddown" fill="url(#grad-winddown)" style="transition: d 0.75s cubic-bezier(0.16,1,0.3,1), opacity 0.3s ease;"/>
                <path id="hc-area-focus" fill="url(#grad-focus)" style="transition: d 0.75s cubic-bezier(0.16,1,0.3,1), opacity 0.3s ease;"/>
                <path id="hc-area-breathing" fill="url(#grad-breathing)" style="transition: d 0.75s cubic-bezier(0.16,1,0.3,1), opacity 0.3s ease;"/>
                <path id="hc-area-water" fill="url(#grad-water)" style="transition: d 0.75s cubic-bezier(0.16,1,0.3,1), opacity 0.3s ease;"/>

                <!-- Habit Trajectory Curves -->
                <path id="hc-line-winddown" fill="none" stroke="#d97706" stroke-width="2.5" stroke-linecap="round" filter="url(#glow-winddown)" style="transition: d 0.75s cubic-bezier(0.16,1,0.3,1), opacity 0.3s ease;"/>
                <path id="hc-line-focus" fill="none" stroke="#4f46e5" stroke-width="2.5" stroke-linecap="round" filter="url(#glow-focus)" style="transition: d 0.75s cubic-bezier(0.16,1,0.3,1), opacity 0.3s ease;"/>
                <path id="hc-line-breathing" fill="none" stroke="#0d9488" stroke-width="2.5" stroke-linecap="round" filter="url(#glow-breathing)" style="transition: d 0.75s cubic-bezier(0.16,1,0.3,1), opacity 0.3s ease;"/>
                <path id="hc-line-water" fill="none" stroke="#0891b2" stroke-width="2.5" stroke-linecap="round" filter="url(#glow-water)" style="transition: d 0.75s cubic-bezier(0.16,1,0.3,1), opacity 0.3s ease;"/>

                <!-- Interactive Vertical Crosshair Cursor -->
                <line id="hc-cursor" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3 3" opacity="0" style="transition: opacity 0.2s ease;"/>

                <!-- Active Trajectory Points (Dots) -->
                <circle id="hc-dot-water" r="5" fill="#0891b2" stroke="#ffffff" stroke-width="2.5" opacity="0" filter="url(#glow-water)" style="transition: opacity 0.2s ease;"/>
                <circle id="hc-dot-breathing" r="5" fill="#0d9488" stroke="#ffffff" stroke-width="2.5" opacity="0" filter="url(#glow-breathing)" style="transition: opacity 0.2s ease;"/>
                <circle id="hc-dot-focus" r="5" fill="#4f46e5" stroke="#ffffff" stroke-width="2.5" opacity="0" filter="url(#glow-focus)" style="transition: opacity 0.2s ease;"/>
                <circle id="hc-dot-winddown" r="5" fill="#d97706" stroke="#ffffff" stroke-width="2.5" opacity="0" filter="url(#glow-winddown)" style="transition: opacity 0.2s ease;"/>

                <!-- Transparent Mouse/Touch Area -->
                <rect id="hc-mouse-area" fill="transparent" class="cursor-crosshair"/>
              </svg>
            </div>
          </div>


          <!-- Dynamic 4-Habit Breakdown Matrix for Selected Day -->
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider font-semibold">Active Habits Status for Selected Day</span>
              <span id="selected-day-completion-tag" class="text-xs font-semibold text-primary">4 of 4 Completed (100%)</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
              <!-- Habit 1: Hydration -->
              <div class="p-3.5 rounded-xl bg-surface-container-low hairline flex flex-col justify-between">
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px] text-cyan-600">water_drop</span>
                    <span class="text-xs font-semibold text-on-surface">Morning Water</span>
                  </div>
                  <span id="habit-status-1" class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-semibold">Logged 7:15 AM</span>
                </div>
                <div class="space-y-1">
                  <div class="w-full h-2 rounded-full bg-surface-container overflow-hidden">
                    <div id="habit-bar-1" class="h-full bg-cyan-600 rounded-full transition-all duration-700" style="width: 100%"></div>
                  </div>
                  <div class="flex justify-between text-[10px] text-outline">
                    <span>8 oz spring water</span>
                    <span id="habit-pct-1" class="font-bold text-on-surface">100%</span>
                  </div>
                </div>
              </div>

              <!-- Habit 2: Box Breathing -->
              <div class="p-3.5 rounded-xl bg-surface-container-low hairline flex flex-col justify-between">
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px] text-teal-600">air</span>
                    <span class="text-xs font-semibold text-on-surface">Box Breathing</span>
                  </div>
                  <span id="habit-status-2" class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-semibold">Logged 8:00 AM</span>
                </div>
                <div class="space-y-1">
                  <div class="w-full h-2 rounded-full bg-surface-container overflow-hidden">
                    <div id="habit-bar-2" class="h-full bg-teal-600 rounded-full transition-all duration-700" style="width: 100%"></div>
                  </div>
                  <div class="flex justify-between text-[10px] text-outline">
                    <span>4-4-4-4 stillness</span>
                    <span id="habit-pct-2" class="font-bold text-on-surface">100%</span>
                  </div>
                </div>
              </div>

              <!-- Habit 3: Deep Focus Block -->
              <div class="p-3.5 rounded-xl bg-surface-container-low hairline flex flex-col justify-between">
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px] text-indigo-600">target</span>
                    <span class="text-xs font-semibold text-on-surface">Deep Focus Block</span>
                  </div>
                  <span id="habit-status-3" class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-semibold">Logged 10:30 AM</span>
                </div>
                <div class="space-y-1">
                  <div class="w-full h-2 rounded-full bg-surface-container overflow-hidden">
                    <div id="habit-bar-3" class="h-full bg-indigo-600 rounded-full transition-all duration-700" style="width: 100%"></div>
                  </div>
                  <div class="flex justify-between text-[10px] text-outline">
                    <span>45m screen focus</span>
                    <span id="habit-pct-3" class="font-bold text-on-surface">100%</span>
                  </div>
                </div>
              </div>

              <!-- Habit 4: Evening Wind-Down -->
              <div class="p-3.5 rounded-xl bg-surface-container-low hairline flex flex-col justify-between">
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px] text-amber-600">bedtime</span>
                    <span class="text-xs font-semibold text-on-surface">Evening Wind-Down</span>
                  </div>
                  <span id="habit-status-4" class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-semibold">Logged 9:15 PM</span>
                </div>
                <div class="space-y-1">
                  <div class="w-full h-2 rounded-full bg-surface-container overflow-hidden">
                    <div id="habit-bar-4" class="h-full bg-amber-600 rounded-full transition-all duration-700" style="width: 100%"></div>
                  </div>
                  <div class="flex justify-between text-[10px] text-outline">
                    <span>Screen detox &amp; tea</span>
                    <span id="habit-pct-4" class="font-bold text-on-surface">100%</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ⭐ 2. UPGRADED DAILY PRACTICE DENSITY (CIRCULAR PROGRESS CALENDAR) ⭐ -->
      <section class="mb-space-xl">
        <div class="bg-surface-container-lowest rounded-2xl p-space-lg sm:p-8 shadow-sm hairline">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm mb-space-lg">
            <div>
              <div class="flex items-center gap-2">
                <h2 class="font-headline-sm text-headline-sm text-on-surface font-medium">Daily practice density calendar</h2>
                <span class="px-2.5 py-0.5 rounded-full bg-primary-fixed text-primary text-[11px] font-semibold">Circular Rings</span>
              </div>
              <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">Click any date to reactively update the energy graph and view habit logs</p>
            </div>
            <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-surface-container-low text-primary font-medium text-xs shadow-xs" id="heatmap-feedback">
              <span class="material-symbols-outlined text-[16px]">touch_app</span>
              <span>Tap any date icon below</span>
            </div>
          </div>

          <!-- Calendar Days Grid (4 Weeks / 28 Days) -->
          <div class="overflow-x-auto pb-2">
            <div class="min-w-[620px]">
              <!-- Day Header -->
              <div class="grid grid-cols-[80px_repeat(7,1fr)] gap-2 mb-3 text-center">
                <div class="text-left font-label-sm text-label-sm text-outline uppercase tracking-wider font-semibold self-center">Cycle</div>
                <div class="font-label-sm text-label-sm text-on-surface font-semibold">Mon</div>
                <div class="font-label-sm text-label-sm text-on-surface font-semibold">Tue</div>
                <div class="font-label-sm text-label-sm text-on-surface font-semibold">Wed</div>
                <div class="font-label-sm text-label-sm text-on-surface font-semibold">Thu</div>
                <div class="font-label-sm text-label-sm text-on-surface font-semibold">Fri</div>
                <div class="font-label-sm text-label-sm text-on-surface font-semibold">Sat</div>
                <div class="font-label-sm text-label-sm text-on-surface font-semibold">Sun</div>
              </div>

              <!-- Week 1 -->
              <div class="grid grid-cols-[80px_repeat(7,1fr)] gap-2 items-center mb-3">
                <span class="font-label-sm text-label-sm text-on-surface-variant font-medium">Week 1</span>
                <!-- Day 1: 100% -->
                <div class="flex justify-center">
                  <button class="date-circle-btn" onclick="selectCalendarDate(this, 0)" title="Mon, Week 1 - 4/4 habits (100%)">
                    <div class="date-circle-glow"></div>
                    <svg class="w-11 h-11 date-circle-svg" viewBox="0 0 36 36"><circle cx="18" cy="18" r="14.5" fill="none" stroke="#e8e8e7" stroke-width="2.5"/><circle cx="18" cy="18" r="14.5" fill="none" class="date-ring-circle" stroke="#0f6e56" stroke-width="2.5" stroke-dasharray="91.1" stroke-dashoffset="0" stroke-linecap="round"/></svg>
                    <span class="absolute font-sans text-xs font-semibold text-on-surface">1</span>
                  </button>
                </div>
                <!-- Day 2: 100% -->
                <div class="flex justify-center">
