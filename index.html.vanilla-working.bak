                </div>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-xs text-outline">2</span>
                <input id="notif-budget-slider" type="range" min="2" max="15" value="6" oninput="MomentumReminderEngine.updateBudget(this.value)" class="flex-1 accent-primary cursor-pointer" />
                <span class="text-xs text-outline">15</span>
              </div>
            </div>

            <!-- Quiet Hours (Do Not Disturb) -->
            <div class="p-4 rounded-2xl bg-surface-container-low space-y-3">
              <div class="flex items-center justify-between">
                <div>
                  <h4 class="text-xs font-semibold text-on-surface">Quiet Hours (Do Not Disturb)</h4>
                  <p class="text-[11px] text-on-surface-variant">Momentum silences all nudges during your restorative sleep</p>
                </div>
