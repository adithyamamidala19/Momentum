<!-- VIEW: TODAY (HOME)                                      -->
<!-- ─────────────────────────────────────────────────────── -->
<div id="view-today" class="view" role="main">
  <div class="w-full pt-20 max-w-[1080px] mx-auto px-margin md:px-margin-desktop pb-space-xl">
    <div class="max-w-[720px] w-full mx-auto flex flex-col gap-space-xl">
      <!-- 1. Header Area -->
      <header class="flex flex-col gap-space-xs">
        <div class="flex items-center justify-between">
          <span class="font-label-sm text-label-sm text-outline tracking-wider" id="today-date-string">Tuesday, October 24</span>
          <!-- Prominent Streak Indicator -->
          <button onclick="openStreakModal()" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary-fixed/40 text-primary border border-primary-container/20 text-label-sm font-label-sm font-medium shadow-xs hover:bg-primary-fixed/60 transition-colors cursor-pointer border-0">
            <span class="w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
            <span id="streak-counter-pill">🔥 7-Day Streak Active</span>
          </button>
        </div>
        <h1 id="today-greeting" class="font-headline-lg text-headline-lg text-on-surface font-medium tracking-tight">Good morning, Adithya</h1>
      </header>

      <!-- 2. Affirmation Line -->
      <div class="border-l-2 border-primary-container pl-space-md py-space-xs">
        <p class="font-editorial-quote text-editorial-quote text-on-surface-variant italic font-normal leading-relaxed">
          “Small, steady actions today quietly shape the person you become.”
        </p>
      </div>

            <!-- SMART REMINDER & CALM ESCALATION CONTAINER -->
      <div id="reminder-banner-container" class="flex flex-col gap-3 transition-all duration-300 empty:hidden" role="region" aria-label="Calm Reminders"></div>

      <!-- 3. CALM HERO CARD: SINGLE FOCAL PROGRESS RING & 7-DOT RHYTHM ROW -->
      <section class="bg-surface-container-lowest rounded-[28px] p-6 sm:p-7 shadow-xs hairline relative overflow-hidden mb-space-lg">
        <!-- Subtle Ambient Glow -->
        <div class="absolute -top-12 -right-12 w-48 h-48 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex flex-col sm:flex-row items-center sm:items-start justify-between gap-6 relative z-10">
          <div class="flex items-center gap-5">
            <!-- Multi-Ring Concentric Circular Progress Visualization (Spacious 160x160 Layout) -->
            <div class="flex flex-col items-center sm:items-start gap-2.5">
              <div class="relative w-36 h-36 sm:w-40 sm:h-40 shrink-0 flex items-center justify-center">
                <svg class="w-full h-full transform -rotate-90 hero-ring-glow" viewBox="0 0 160 160">
                  <defs>
                    <radialGradient id="ringCenterAura" cx="50%" cy="50%" r="50%">
                      <stop offset="0%" stop-color="#0f6e56" stop-opacity="0.08"/>
                      <stop offset="70%" stop-color="#0f6e56" stop-opacity="0.02"/>
                      <stop offset="100%" stop-color="#0f6e56" stop-opacity="0"/>
                    </radialGradient>
                  </defs>

                  <!-- Subtle Ambient Center Backdrop Circle -->
                  <circle cx="80" cy="80" r="34" fill="url(#ringCenterAura)"/>

                  <!-- Outer Track: Daily Habits (r=68, c=427.26, stroke=6.0) -->
                  <circle cx="80" cy="80" r="68" stroke="#e6eee9" stroke-width="6.0" fill="none"/>
                  <circle id="hero-ring-habits" cx="80" cy="80" r="68" stroke="#0f6e56" stroke-width="6.0" fill="none"
                          stroke-linecap="round" stroke-dasharray="427.26" stroke-dashoffset="427.26"
                          class="concentric-ring-habits"/>
                  
                  <!-- Middle Track: Mindful Focus Minutes (r=54, c=339.29, stroke=6.0) -->
                  <circle cx="80" cy="80" r="54" stroke="#f8eedc" stroke-width="6.0" fill="none"/>
                  <circle id="hero-ring-focus" cx="80" cy="80" r="54" stroke="#d97706" stroke-width="6.0" fill="none"
                          stroke-linecap="round" stroke-dasharray="339.29" stroke-dashoffset="339.29"
                          class="concentric-ring-focus"/>
                  
                  <!-- Inner Track: Hydration / Vitality (r=40, c=251.33, stroke=6.0) -->
                  <circle cx="80" cy="80" r="40" stroke="#e0f2f7" stroke-width="6.0" fill="none"/>
                  <circle id="hero-ring-water" cx="80" cy="80" r="40" stroke="#0891b2" stroke-width="6.0" fill="none"
                          stroke-linecap="round" stroke-dasharray="251.33" stroke-dashoffset="251.33"
                          class="concentric-ring-water"/>
                </svg>

                <!-- Centered Overall Daily Rhythm Score / Percentage (Spacious & Clean) -->
                <div class="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none select-none z-10">
                  <span id="hero-progress-pct" class="font-sans font-extrabold text-2xl sm:text-3xl text-primary tracking-tight leading-none">80%</span>
                  <span class="text-[9px] sm:text-[10px] uppercase tracking-widest text-outline font-semibold mt-1">score</span>
                </div>
              </div>

              <!-- Concentric Rings Habit Metrics Legend -->
              <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
                <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-surface-container-low text-[10px] text-on-surface font-medium border border-surface-container shadow-xs">
                  <span class="w-2 h-2 rounded-full bg-[#0f6e56]"></span>
                  <span id="legend-habits-val">Habits: 4/5 (80%)</span>
                </div>
                <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-surface-container-low text-[10px] text-on-surface font-medium border border-surface-container shadow-xs">
                  <span class="w-2 h-2 rounded-full bg-[#d97706]"></span>
                  <span id="legend-focus-val">Focus: 20/25m (80%)</span>
                </div>
                <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-surface-container-low text-[10px] text-on-surface font-medium border border-surface-container shadow-xs">
                  <span class="w-2 h-2 rounded-full bg-[#0891b2]"></span>
                  <span id="legend-water-val">Water: 6/8 (75%)</span>
                </div>
              </div>
            </div></div>

            <div class="flex flex-col gap-0.5">
              <span id="today-progress-headline" class="font-headline-sm text-headline-sm text-on-surface font-medium">Your rhythm in motion</span>
              <p id="today-progress-sub" class="font-body-md text-body-md text-outline">4 of 5 rituals completed today.</p>
              
              <!-- Calm Supporting Streak Line -->
              <div class="inline-flex items-center gap-1.5 mt-1 text-xs text-primary font-medium">
                <span class="w-1.5 h-1.5 rounded-full bg-primary-container"></span>
                <span id="hero-streak-display">12-day rhythm · best 24</span>
              </div>
            </div>
          </div>

          <!-- Quick Session & Calm Actions -->
          <div class="flex sm:flex-col items-center sm:items-end justify-center gap-2 sm:pl-space-md sm:border-l sm:border-surface-container">
            <button onclick="openFocusTimer()" class="px-3.5 py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-primary text-xs font-medium transition-all hairline flex items-center gap-1.5 cursor-pointer border-0">
              <span class="material-symbols-outlined text-[15px] text-primary">timer</span>
              <span>Focused session</span>
            </button>
            <button onclick="openMovementLogger()" class="px-3.5 py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-secondary text-xs font-medium transition-all hairline flex items-center gap-1.5 cursor-pointer border-0">
              <span class="material-symbols-outlined text-[15px] text-secondary">fitness_center</span>
              <span>Log movement</span>
            </button>
          </div>
        </div>

        <div class="h-px bg-surface-container my-space-lg"></div>

        <!-- 7-Dot Weekly Rhythm Row with Active Today Dot -->
        <div class="flex flex-col gap-space-sm">
          <div class="grid grid-cols-7 gap-space-xs items-center text-center">
            <div class="flex flex-col items-center gap-space-xs">
              <span class="font-label-sm text-label-sm text-outline">Mon</span>
              <div class="w-6 h-6 rounded-full flex items-center justify-center bg-primary-fixed/40 text-primary">
                <span class="material-symbols-outlined text-[14px]">check</span>
              </div>
            </div>
            <div class="flex flex-col items-center gap-space-xs">
              <span class="font-label-sm text-label-sm text-outline">Tue</span>
              <div class="w-6 h-6 rounded-full flex items-center justify-center bg-primary-fixed/40 text-primary">
                <span class="material-symbols-outlined text-[14px]">check</span>
              </div>
            </div>
            <div class="flex flex-col items-center gap-space-xs">
              <span class="font-label-sm text-label-sm text-on-surface font-medium">Wed</span>
              <div class="w-6 h-6 rounded-full flex items-center justify-center ring-2 ring-primary-container/60 bg-primary-fixed/50">
                <span id="today-streak-dot" class="w-3 h-3 rounded-full bg-primary-container" title="Today"></span>
              </div>
            </div>
            <div class="flex flex-col items-center gap-space-xs">
              <span class="font-label-sm text-label-sm text-outline-variant">Thu</span>
              <span class="w-3.5 h-3.5 rounded-full border border-dashed border-outline-variant" title="Upcoming"></span>
            </div>
            <div class="flex flex-col items-center gap-space-xs">
              <span class="font-label-sm text-label-sm text-outline-variant">Fri</span>
              <span class="w-3.5 h-3.5 rounded-full border border-dashed border-outline-variant" title="Upcoming"></span>
            </div>
            <div class="flex flex-col items-center gap-space-xs">
              <span class="font-label-sm text-label-sm text-outline-variant">Sat</span>
              <span class="w-3.5 h-3.5 rounded-full border border-dashed border-outline-variant" title="Upcoming"></span>
            </div>
            <div class="flex flex-col items-center gap-space-xs">
              <span class="font-label-sm text-label-sm text-outline-variant">Sun</span>
              <span class="w-3.5 h-3.5 rounded-full border border-dashed border-outline-variant" title="Upcoming"></span>
            </div>
          </div>
          <div class="flex items-center justify-center gap-space-lg pt-space-xs">
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-primary-container"></span>
              <span class="font-label-sm text-label-sm text-outline">Active Today</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-primary-fixed/70"></span>
              <span class="font-label-sm text-label-sm text-outline">Rhythm Protected</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. Context Weather Line -->
      <div class="flex items-center gap-space-sm px-space-xs text-on-surface-variant">
        <span class="material-symbols-outlined text-[20px] text-secondary">wb_sunny</span>
        <span class="font-body-md text-body-md text-on-surface-variant">68° and calm ”” gentle sunlight for your morning ritual</span>
      </div>

      <!-- 6. ⭐ DAILY PRACTICE & CUSTOMIZABLE HABIT OPTIONS ⭐ -->
      <section class="flex flex-col gap-space-md">
        <!-- Section Header with Add Habit Button -->
        <div class="flex items-center justify-between px-space-xs flex-wrap gap-2">
          <div>
            <h2 class="font-headline-sm text-headline-sm text-on-surface font-medium">Daily practice</h2>
            <span class="font-label-sm text-label-sm text-outline" id="today-sub-date">Customize and complete habits</span>
          </div>
          
          <div class="flex items-center gap-2">
            <!-- Customizable Habit Button -->
            <button onclick="openCustomHabitModal()" class="px-3.5 py-1.5 rounded-full bg-primary-container hover:bg-primary text-on-primary text-xs font-medium transition-all shadow-xs flex items-center gap-1.5 cursor-pointer border-0 active:scale-95">
              <span class="material-symbols-outlined text-[16px]">add_circle</span>
              <span>+ Add Habit</span>
            </button>
          </div>
        </div>

        <!-- Quick-Add Habit Pills (One-tap creation) -->
        <div class="flex items-center gap-2 overflow-x-auto py-1 px-space-xs no-scrollbar" aria-label="Quick add habit suggestions">
          <span class="text-xs text-outline font-medium shrink-0">Quick add:</span>
          <button onclick="quickAddHabit('💧 500ml Morning Water', 'water_drop', 'right after waking', 'Health', 'emerald')" class="quick-habit-pill shrink-0 px-3 py-1 rounded-full bg-surface-container-lowest hairline text-xs text-on-surface-variant font-medium flex items-center gap-1 cursor-pointer">
            <span>💧 500ml Water</span>
          </button>
          <button onclick="quickAddHabit('🧘 5-min Box Breathing', 'air', 'before opening laptop', 'Mind', 'teal')" class="quick-habit-pill shrink-0 px-3 py-1 rounded-full bg-surface-container-lowest hairline text-xs text-on-surface-variant font-medium flex items-center gap-1 cursor-pointer">
            <span>🧘 5m Breath</span>
          </button>
          <button onclick="quickAddHabit('📖 Read 10 Pages', 'auto_stories', 'with evening tea', 'Craft', 'amber')" class="quick-habit-pill shrink-0 px-3 py-1 rounded-full bg-surface-container-lowest hairline text-xs text-on-surface-variant font-medium flex items-center gap-1 cursor-pointer">
            <span>📖 Read 10 Pages</span>
          </button>
          <button onclick="quickAddHabit('🚶 15-min Daylight Walk', 'directions_walk', 'after lunch', 'Health', 'emerald')" class="quick-habit-pill shrink-0 px-3 py-1 rounded-full bg-surface-container-lowest hairline text-xs text-on-surface-variant font-medium flex items-center gap-1 cursor-pointer">
            <span>🚶 15m Walk</span>
          </button>
          <button onclick="quickAddHabit('✍️ 3-Line Gratitude Journal', 'draw', 'before going to sleep', 'Mind', 'teal')" class="quick-habit-pill shrink-0 px-3 py-1 rounded-full bg-surface-container-lowest hairline text-xs text-on-surface-variant font-medium flex items-center gap-1 cursor-pointer">
            <span>✍️ Gratitude</span>
          </button>
          <button onclick="quickAddHabit('📵 Phone-Free Lunch', 'notifications_off', 'during midday meal', 'Focus', 'indigo')" class="quick-habit-pill shrink-0 px-3 py-1 rounded-full bg-surface-container-lowest hairline text-xs text-on-surface-variant font-medium flex items-center gap-1 cursor-pointer">
            <span>📵 Quiet Lunch</span>
          </button>
        </div>

        <!-- Habits List -->
        <div class="flex flex-col gap-space-sm" id="today-rituals-list">
          <!-- ⭐ PERSONALIZED FIRST RITUAL (Injected dynamically) -->
          <div id="personalized-first-ritual-card" class="group relative flex items-center justify-between p-space-md bg-surface-container-lowest rounded-2xl hairline shadow-sm border-2 border-primary-container/40 transition-all duration-300">
            <div class="flex items-center gap-space-md min-w-0">
              <div id="first-ritual-icon-box" class="w-11 h-11 rounded-xl bg-primary-fixed text-primary-container flex items-center justify-center shrink-0">
                <span id="first-ritual-icon" class="material-symbols-outlined text-[22px]">water_drop</span>
              </div>
              <div class="flex flex-col min-w-0">
                <div class="flex items-center gap-2 mb-0.5">
                  <span class="px-2 py-0.5 rounded-full bg-primary-fixed text-primary text-[10px] font-medium uppercase tracking-wider">Your First Ritual</span>
                  <span class="text-xs text-primary font-medium">Ready to complete</span>
                </div>
                <span id="first-ritual-name" class="ritual-title font-headline-sm text-headline-sm text-on-surface font-medium truncate">Morning hydration &amp; vital reset</span>
                <span id="first-ritual-anchor-label" class="font-body-sm text-body-sm text-outline truncate">Anchor: right after waking up, before checking screens</span>
              </div>
            </div>
            <button id="first-ritual-toggle-btn" aria-label="Complete your first ritual" onclick="completeFirstRitual(this)" class="w-8 h-8 rounded-full border-2 border-primary-container hover:bg-primary-fixed/40 flex items-center justify-center text-primary-container shrink-0 cursor-pointer transition-all duration-200 active:scale-90 bg-transparent" type="button">
            </button>
          </div>

          <!-- Secondary Ritual: Quiet Stillness -->
          <div class="habit-item-row group flex items-center justify-between p-space-md bg-surface-container-lowest rounded-xl hairline transition-all duration-200" data-habit-id="default-stillness">
            <div class="flex items-center gap-space-md min-w-0">
              <div class="w-10 h-10 rounded-lg bg-surface-container-low text-outline flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[20px]">self_improvement</span>
              </div>
              <div class="flex flex-col min-w-0">
                <span class="ritual-title font-headline-sm text-headline-sm text-on-surface font-medium truncate">Quiet stillness pause</span>
                <span class="font-body-sm text-body-sm text-outline truncate">Anchor: before morning tea or coffee</span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <button aria-label="Toggle Quiet stillness" onclick="toggleTodayRitual(this)" class="ritual-toggle w-6 h-6 rounded-full border border-outline hover:border-primary-container flex items-center justify-center flex-shrink-0 cursor-pointer transition-colors active:scale-95 bg-transparent" type="button">
              </button>
            </div>
          </div>

          <!-- Secondary Ritual: Evening Walk -->
          <div class="habit-item-row group flex items-center justify-between p-space-md bg-surface-container-lowest rounded-xl hairline transition-all duration-200" data-habit-id="default-walk">
            <div class="flex items-center gap-space-md min-w-0">
              <div class="w-10 h-10 rounded-lg bg-surface-container-low text-outline flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[20px]">directions_walk</span>
              </div>
              <div class="flex flex-col min-w-0">
                <span class="ritual-title font-headline-sm text-headline-sm text-on-surface font-medium truncate">Evening walk</span>
                <span class="font-body-sm text-body-sm text-outline truncate">Anchor: right after concluding work</span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <button aria-label="Mark Evening walk completed" onclick="toggleTodayRitual(this)" class="ritual-toggle w-6 h-6 rounded-full border border-outline hover:border-primary-container flex items-center justify-center flex-shrink-0 cursor-pointer transition-colors active:scale-95 bg-transparent" type="button">
              </button>
            </div>
          </div>

          <!-- Container for User Added Custom Habits -->
          <div id="custom-habits-container" class="flex flex-col gap-space-sm"></div>
        </div>
      </section>

      <!-- 6.5 ⭐ MINDFUL TO-DO LIST (ONE-OFF DATE-SCOPED TASKS) ⭐ -->
      <section id="today-todos-section" class="flex flex-col gap-space-md" aria-labelledby="today-todos-heading">
        <div class="flex items-center justify-between px-space-xs flex-wrap gap-2">
          <div class="flex items-center gap-2.5">
            <h2 id="today-todos-heading" class="font-headline-sm text-headline-sm text-on-surface font-medium">Today's To-Dos</h2>
            <span id="today-todos-count" class="text-[11px] px-2 py-0.5 rounded-full bg-surface-container text-outline">0 left</span>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="navigate('todos')" class="text-xs text-primary hover:underline font-medium cursor-pointer border-0 bg-transparent flex items-center gap-1" type="button">
              <span>View All Tasks</span>
              <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            </button>
          </div>
        </div>

        <!-- Quick Add Form -->
        <form onsubmit="handleQuickAddTodo(event)" class="flex items-center gap-2">
          <div class="relative flex-1">
            <input type="text" id="today-todo-quick-input" placeholder="Add a to-do for today... (or say 'Create a to-do list for today')"
                   class="w-full px-4 py-2.5 rounded-xl bg-surface-container-lowest hairline text-xs sm:text-sm text-on-surface placeholder:text-outline focus:outline-none focus:ring-1 focus:ring-primary-container transition-all">
          </div>
          <button type="submit" class="px-4 py-2.5 rounded-xl bg-primary hover:bg-primary-container text-on-primary text-xs font-semibold shadow-xs transition-colors cursor-pointer border-0 flex items-center gap-1 shrink-0">
            <span class="material-symbols-outlined text-[16px]">add</span>
            <span class="hidden sm:inline">Add</span>
          </button>
        </form>

        <!-- To-Do Cards Container -->
        <div id="today-todos-list" class="flex flex-col gap-2" role="list" aria-label="Today's To-Dos">
          <!-- Populated dynamically by renderTodosUI -->
        </div>
      </section>

      <!-- 7. ⭐ GROUNDED HOME SCREEN AI ASSISTANT BOT ⭐ -->
      <section id="home-ai-assistant-widget" class="bg-surface-container-lowest rounded-[28px] p-6 sm:p-7 shadow-xs hairline relative overflow-hidden mb-space-lg">
        <div class="flex items-center justify-between mb-3.5">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[22px]">smart_toy</span>
            </div>
            <div>
              <h2 class="font-headline-sm text-base sm:text-lg text-on-surface font-semibold flex items-center gap-2">
                <span>Mindful Personal Assistant</span>
                <span class="px-2 py-0.5 rounded-full bg-primary-fixed/50 text-[10px] text-primary font-bold uppercase tracking-wider">Zero Hallucination</span>
              </h2>
              <p class="font-body-sm text-xs text-outline">Grounded strictly in your real website data · No made-up stats</p>
            </div>
          </div>
          <button onclick="clearAssistantChat()" class="px-3 py-1 rounded-full bg-surface-container hover:bg-surface-container-high text-outline hover:text-on-surface text-xs font-medium transition-all hairline cursor-pointer border-0 flex items-center gap-1" title="Reset chat">
            <span class="material-symbols-outlined text-[14px]">refresh</span>
            <span>Reset</span>
          </button>
        </div>

        <!-- Suggestion Quick Prompt Chips -->
        <div class="flex items-center gap-2 overflow-x-auto pb-2.5 mb-3 no-scrollbar text-xs">
          <button onclick="askAssistantChip('What is my current score?')" class="px-3 py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-primary font-medium hairline shrink-0 transition-all cursor-pointer border-0">📊 Current score</button>
          <button onclick="askAssistantChip('How many habits did I complete today?')" class="px-3 py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-primary font-medium hairline shrink-0 transition-all cursor-pointer border-0">✅ Completed habits</button>
          <button onclick="askAssistantChip('What is my current streak?')" class="px-3 py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-primary font-medium hairline shrink-0 transition-all cursor-pointer border-0">🔥 Current streak</button>
          <button onclick="askAssistantChip('How much focus time did I complete?')" class="px-3 py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-primary font-medium hairline shrink-0 transition-all cursor-pointer border-0">⏱️ Focus time</button>
          <button onclick="askAssistantChip('What workouts did I log recently?')" class="px-3 py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-primary font-medium hairline shrink-0 transition-all cursor-pointer border-0">🏋️ Recent workouts</button>
          <button onclick="askAssistantChip('How much weight did I use for my workouts?')" class="px-3 py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-primary font-medium hairline shrink-0 transition-all cursor-pointer border-0">⚖️ Workout weight</button>
          <button onclick="askAssistantChip('What achievements did I complete?')" class="px-3 py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-primary font-medium hairline shrink-0 transition-all cursor-pointer border-0">🏆 Milestones</button>
          <button onclick="askAssistantChip('How is my progress this week?')" class="px-3 py-1.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-primary font-medium hairline shrink-0 transition-all cursor-pointer border-0">📈 Weekly progress</button>
        </div>

        <!-- Chat Conversation Messages Container -->
        <div id="ai-chat-messages" class="flex flex-col gap-2.5 p-3.5 rounded-2xl bg-surface-container-lowest hairline max-h-64 overflow-y-auto mb-3 scroll-smooth">
          <!-- Initial Welcome Message from Assistant -->
          <div class="chat-bubble-bot">
            <span class="font-semibold text-primary block mb-0.5">Mindful Assistant</span>
            Hello Adithya. I am your personal assistant. I answer questions grounded strictly in your real activity, habits, workouts, focus sessions, and streak data. Ask me anything below!
          </div>
        </div>

        <!-- Input Query Bar -->
        <form onsubmit="handleAssistantSubmit(event)" class="flex items-center gap-2">
          <input type="text" id="ai-chat-input" placeholder="Ask about your score, habits, workouts, focus time, streaks..." class="flex-1 px-4 py-3 rounded-xl bg-surface-container-lowest hairline text-sm text-on-surface placeholder:text-outline focus:outline-none focus:ring-1 focus:ring-primary">
          <button type="submit" class="px-5 py-3 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-semibold text-sm transition-all shadow-xs flex items-center justify-center gap-1.5 cursor-pointer border-0 shrink-0">
            <span class="material-symbols-outlined text-[18px]">send</span>
            <span class="hidden sm:inline">Ask</span>
          </button>
        </form>
      </section>


      <!-- 7. Behavioral Insight Line -->
      <div class="px-space-xs py-space-sm text-center sm:text-left">
        <p class="font-body-md text-body-md text-outline">
          You've practiced rhythm on 7 of the last 7 days. Your burning streak is unlocked.
        </p>
      </div>

      <!-- 8. Bottom Actions -->
      <div class="flex items-center justify-center gap-3 pt-space-xs pb-space-lg flex-wrap">
        <button onclick="openCustomHabitModal()" class="bg-primary-container hover:bg-primary text-on-primary font-label-md text-label-md rounded-full px-5 py-2.5 transition-colors focus:outline-none focus:ring-1 focus:ring-primary-container active:scale-[0.99] cursor-pointer border-0 shadow-xs flex items-center gap-1.5" type="button">
          <span class="material-symbols-outlined text-[18px]">add</span>
          <span>Add Custom Habit</span>
        </button>
        <button onclick="openBuildRitualDrawer()" class="border border-outline-variant hover:bg-surface-container-low text-on-surface-variant font-label-md text-label-md rounded-full px-5 py-2.5 transition-colors focus:outline-none focus:ring-1 focus:ring-primary-container active:scale-[0.99] cursor-pointer bg-transparent" type="button">
          Explore Suggested Rituals
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ─────────────────────────────────────────────────────── -->

<!-- ─────────────────────────────────────────────────────── -->
<!-- ─────────────────────────────────────────────────────── -->
<!-- VIEW: DEDICATED AI VOICE AGENT SCREEN                   -->
<!-- ─────────────────────────────────────────────────────── -->
<div id="view-voice" class="view" role="main">
  <!-- Smooth Ambient Focus Backdrop -->
  <div id="voice-focus-backdrop" class="voice-focus-backdrop"></div>

  <div class="voice-screen-stage">
    <!-- Top Bar Status & Quick Controls -->
    <div class="voice-top-bar">
      <div id="voice-status-badge" class="voice-status-badge">
        <span class="voice-status-dot"></span>
        <span id="voice-status-badge-text">ARIA AI AGENT</span>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" id="voice-mute-btn" onclick="MomentumVoiceAgent.toggleMute()" class="voice-top-btn" title="Toggle Voice Output">
          <span class="material-symbols-outlined text-[20px]">volume_up</span>
        </button>
        <button type="button" onclick="MomentumVoiceAgent.closeVoiceMode()" class="voice-top-btn" title="Close and return to Today">
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>
    </div>

    <!-- Central Interactive Voice Hub -->
    <div id="voice-primary-hub" class="voice-primary-hub">
      <!-- Large Central Microphone Orb & Real-Time Oscillation Canvas -->
      <div class="voice-center-orb-wrapper">
        <canvas id="voice-oscillation-canvas" class="voice-oscillation-canvas"></canvas>
        <div id="screen-orb-container" class="voice-center-orb idle" onclick="MomentumVoiceAgent.toggleMic()" role="button" aria-label="Activate voice listening" tabindex="0">
          <div class="voice-pulse-ring ring-1"></div>
          <div class="voice-pulse-ring ring-2"></div>
          <div class="voice-pulse-ring ring-3"></div>
          <div class="voice-orb-core">
            <span class="material-symbols-outlined voice-mic-icon">mic</span>
          </div>
        </div>
      </div>

      <!-- Mode Titles & Live Status -->
      <h2 id="voice-mode-title" class="voice-mode-title">Speak with Aria</h2>
      <p id="screen-voice-status" class="voice-mode-status">
        Tap the microphone to begin listening
      </p>

      <!-- Dynamic Voice Equalizer Waveform Bars -->
      <div id="screen-voice-waveform" class="voice-waveform-bars">
        <span class="vbar"></span>
        <span class="vbar"></span>
        <span class="vbar"></span>
        <span class="vbar"></span>
        <span class="vbar"></span>
        <span class="vbar"></span>
        <span class="vbar"></span>
      </div>

      <!-- Real-Time Live Transcript Subtitle Card -->
      <div id="voice-transcript-card" class="voice-transcript-card">
        <div class="voice-transcript-header">
          <span class="voice-transcript-badge">
            <span class="material-symbols-outlined text-[14px]">graphic_eq</span>
            Real-time transcript
          </span>
          <span id="voice-mode-pill" class="voice-mode-pill">Interactive Voice Mode</span>
        </div>
        <p id="screen-transcript-text" class="voice-transcript-body">
          "What habits do I have left today?" &middot; "Start a 25-minute focus session" &middot; "Add habit drink water at 8am"
        </p>
      </div>

      <!-- Quick Action Inspiration Chips (Smoothly folds during voice listening) -->
      <div id="voice-chips-container" class="voice-chips-container">
        <button type="button" onclick="MomentumVoiceAgent.runCommandText('What\'s left today?')" class="voice-chip">💬 What's left today?</button>
        <button type="button" onclick="MomentumVoiceAgent.runCommandText('Good morning Aria')" class="voice-chip">🌅 Morning briefing</button>
        <button type="button" onclick="MomentumVoiceAgent.runCommandText('Start focus session')" class="voice-chip">⏱️ Start focus</button>
        <button type="button" onclick="MomentumVoiceAgent.runCommandText('Mark hydration as complete')" class="voice-chip">💧 Mark water done</button>
        <button type="button" onclick="MomentumVoiceAgent.runCommandText('Go to Insights')" class="voice-chip">📊 Open Insights</button>
      </div>
    </div>

    <!-- Bottom Voice & Keyboard Fallback Control Bar -->
    <div class="voice-bottom-bar-wrap">
      <form onsubmit="MomentumVoiceAgent.handleTextSubmit(event)" class="voice-input-form">
        <button type="button" id="voice-bar-mic-btn" onclick="MomentumVoiceAgent.toggleMic()" class="voice-bar-mic-btn" title="Toggle Microphone">
          <span class="material-symbols-outlined text-[22px]">mic</span>
        </button>
        <input type="text" id="screen-text-input" placeholder="Type a voice command or question..." class="voice-text-input" autocomplete="off" />
        <button type="submit" class="voice-bar-send-btn" title="Send text command">
          <span class="material-symbols-outlined text-[18px]">send</span>
        </button>
      </form>
    </div>
  </div>
</div>

<!-- ─────────────────────────────────────────────────────── -->
<!-- VIEW: TO-DOS (DATE-SCOPED TASKS)                        -->
<!-- ─────────────────────────────────────────────────────── -->
<div id="view-todos" class="view" role="main">
  <div class="w-full pt-20 max-w-[1080px] mx-auto px-margin md:px-margin-desktop pb-space-xl">
    <div class="max-w-[720px] w-full mx-auto flex flex-col gap-space-lg">
      <!-- Header -->
      <header class="flex flex-col gap-space-xs">
        <div class="flex items-center justify-between">
          <span class="font-label-sm text-label-sm text-outline tracking-wider">Mindful Task Sanctuary</span>
          <button onclick="navigate('today')" class="text-xs text-outline hover:text-primary transition-colors flex items-center gap-1 border-0 bg-transparent cursor-pointer">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            <span>Back to Today</span>
          </button>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface font-medium tracking-tight">Daily To-Dos</h1>
        <p id="todos-view-summary" class="font-body-md text-sm text-outline">Manage one-off date-scoped tasks with stillness and clarity.</p>
      </header>

      <!-- Add To-Do Card -->
      <div class="bg-surface-container-lowest rounded-3xl p-5 shadow-xs hairline">
        <form onsubmit="handleFullAddTodo(event)" class="flex flex-col gap-3">
          <div class="flex items-center gap-2">
            <input type="text" id="full-todo-input-title" placeholder="What would you like to accomplish?" required
                   class="flex-1 px-4 py-3 rounded-2xl bg-surface-container-low hairline text-sm text-on-surface placeholder:text-outline focus:outline-none focus:ring-1 focus:ring-primary-container transition-all">
          </div>
          <div class="flex items-center justify-between gap-3 flex-wrap">
            <div class="flex items-center gap-2">
              <label for="full-todo-input-date" class="text-xs text-outline flex items-center gap-1">
                <span class="material-symbols-outlined text-[16px]">calendar_today</span> Date:
              </label>
              <input type="date" id="full-todo-input-date"
                     class="px-3 py-1.5 rounded-xl bg-surface-container-low hairline text-xs text-on-surface focus:outline-none focus:ring-1 focus:ring-primary-container">
            </div>
            <div class="flex items-center gap-2">
              <label for="full-todo-input-priority" class="text-xs text-outline flex items-center gap-1">
                <span class="material-symbols-outlined text-[16px]">flag</span> Priority:
              </label>
              <select id="full-todo-input-priority" class="px-3 py-1.5 rounded-xl bg-surface-container-low hairline text-xs text-on-surface focus:outline-none focus:ring-1 focus:ring-primary-container">
                <option value="normal" selected>Normal</option>
                <option value="high">High</option>
                <option value="low">Low</option>
              </select>
            </div>
            <button type="submit" class="px-5 py-2 rounded-xl bg-primary hover:bg-primary-container text-on-primary text-xs font-semibold shadow-xs transition-colors cursor-pointer border-0 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px]">add</span>
              <span>Add Task</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Filter Tabs -->
      <div class="flex items-center justify-between px-1 flex-wrap gap-2">
        <div class="flex items-center gap-1.5">
          <button type="button" id="todo-tab-today" onclick="setTodosFilter('today')" class="px-3 py-1.5 rounded-full bg-primary text-on-primary text-xs font-semibold shadow-xs border-0 cursor-pointer transition-all">Today</button>
          <button type="button" id="todo-tab-all" onclick="setTodosFilter('all')" class="px-3 py-1.5 rounded-full bg-surface-container hover:bg-surface-container-high text-on-surface text-xs font-medium border-0 cursor-pointer transition-all">All Tasks</button>
          <button type="button" id="todo-tab-completed" onclick="setTodosFilter('completed')" class="px-3 py-1.5 rounded-full bg-surface-container hover:bg-surface-container-high text-on-surface text-xs font-medium border-0 cursor-pointer transition-all">Completed</button>
        </div>
      </div>

      <!-- Tasks List Container -->
      <div id="full-todos-list" class="flex flex-col gap-2.5" role="list" aria-label="To-Do Task List">
        <!-- Rendered by renderTodosUI -->
      </div>
    </div>
  </div>
</div>

<!-- VIEW: RITUALS MANAGEMENT                                -->
<!-- ─────────────────────────────────────────────────────── -->
<div id="view-rituals" class="view" role="main">
  <div class="w-full pt-20 max-w-[1080px] mx-auto px-margin md:px-margin-desktop pb-space-xl">
    <div class="flex flex-col w-full">
      <!-- Top Editorial Header & Quiet Stat Line -->
