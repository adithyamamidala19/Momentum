<!-- ═══════════════════════════════════════════════════════ -->
<!--  ⭐ FORGOT PASSWORD / RESET MODAL                      -->
<!-- ═══════════════════════════════════════════════════════ -->
<div id="modal-forgot-password" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/60 backdrop-blur-sm transition-opacity duration-200">
  <div class="relative w-full max-w-md bg-surface-container-lowest rounded-3xl p-6 sm:p-8 shadow-2xl hairline">
    
    <!-- Close Button -->
    <button type="button" onclick="closeForgotPasswordModal()" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-surface-container hover:bg-surface-container-high flex items-center justify-center text-outline hover:text-on-surface transition-colors cursor-pointer border-0">
      <span class="material-symbols-outlined text-[18px]">close</span>
    </button>

    <!-- Header -->
    <div class="flex items-center gap-3 mb-4">
      <div class="w-12 h-12 rounded-2xl bg-primary-fixed text-primary-container flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-[24px]">lock_reset</span>
      </div>
      <div>
        <h3 class="font-editorial text-2xl text-on-surface font-normal">Reset Password</h3>
        <p class="text-xs text-outline">Receive a secure reset link via email</p>
      </div>
    </div>

    <div id="forgot-pass-feedback" class="hidden w-full p-3 rounded-xl text-xs flex items-start gap-2 mb-4 text-left">
      <span id="forgot-pass-icon" class="material-symbols-outlined text-[16px] shrink-0 mt-0.5">info</span>
      <p id="forgot-pass-msg" class="leading-relaxed flex-1"></p>
    </div>

    <form onsubmit="handleSendPasswordReset(event)" class="space-y-4">
      <div>
        <label for="reset-email" class="block text-xs font-medium text-on-surface-variant mb-1">Your registered email</label>
        <div class="relative flex items-center">
          <span class="material-symbols-outlined absolute left-3.5 text-outline text-[18px]">mail</span>
          <input type="email" id="reset-email" placeholder="name@example.com" required
            class="w-full pl-10 pr-4 py-3 rounded-xl bg-surface-container-lowest hairline text-sm text-on-surface placeholder:text-outline/60 focus:outline-none focus:ring-1 focus:ring-primary-container transition-all">
        </div>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <button type="button" onclick="closeForgotPasswordModal()" class="flex-1 py-3 px-4 rounded-xl bg-surface-container hover:bg-surface-container-high text-xs font-medium text-on-surface transition-colors cursor-pointer border-0">
          Cancel
        </button>
        <button type="submit" id="btn-send-reset" class="flex-1 py-3 px-4 rounded-xl bg-primary-container hover:bg-primary text-on-primary text-xs font-semibold shadow-sm transition-colors cursor-pointer border-0 flex items-center justify-center gap-1.5">
          <span class="material-symbols-outlined text-[16px]">send</span>
          <span>Send Reset Link</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- 1. BUILD A RITUAL SUGGESTIONS DRAWER -->
<!-- ═══════════════════════════════════════════════════════ -->
<!--  ⭐ FULLSCREEN MEDITATIVE FOCUS INTRO OVERLAY          -->
<!-- ═══════════════════════════════════════════════════════ -->
<div id="focus-intro-overlay" role="dialog" aria-modal="true" aria-label="Focus Session Beginning">
  <div class="focus-intro-aura"></div>

  <!-- Stage 1: Earbuds Motion & Instruction Message -->
  <div class="focus-intro-stage-1">
    
    <!-- Vector Earbuds Illustration Floating Upward -->
    <div class="earbuds-motion-box">
      <div class="earbuds-floating-wrap relative flex items-center justify-center">
        <!-- Ambient Sound Waves Rings -->
        <div class="absolute w-44 h-44 rounded-full border border-primary-fixed/20 animate-ping" style="animation-duration: 3.5s;"></div>
        <div class="absolute w-36 h-36 rounded-full border border-primary-fixed/30 animate-pulse"></div>

        <!-- Premium Dual Wireless Earbuds SVG -->
        <svg class="w-32 h-32 sm:w-36 sm:h-36 drop-shadow-[0_12px_32px_rgba(0,0,0,0.8)]" viewBox="0 0 140 140" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="earbudBodyLeft" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#ffffff"/>
              <stop offset="45%" stop-color="#e2e8f0"/>
              <stop offset="100%" stop-color="#94a3b8"/>
            </linearGradient>
            <linearGradient id="earbudBodyRight" x1="100%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#ffffff"/>
              <stop offset="45%" stop-color="#e2e8f0"/>
              <stop offset="100%" stop-color="#94a3b8"/>
            </linearGradient>
            <linearGradient id="earbudTipGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#a0f3d4"/>
              <stop offset="100%" stop-color="#0f6e56"/>
            </linearGradient>
            <linearGradient id="earbudStemGlow" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#ffffff"/>
              <stop offset="100%" stop-color="#cbd5e1"/>
            </linearGradient>
            <filter id="earbudShadow" x="-20%" y="-20%" width="140%" height="140%">
              <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#000000" flood-opacity="0.6"/>
            </filter>
          </defs>

          <!-- LEFT EARBUD -->
          <g transform="translate(18, 22) rotate(-8 30 45)" filter="url(#earbudShadow)">
            <!-- Stem -->
            <path d="M26 38 C26 38 27 68 28 78 C28.5 82 25 85 21 85 C17 85 14 82 14.5 78 C15.5 68 18 38 18 38 Z" fill="url(#earbudStemGlow)"/>
            <circle cx="21" cy="81" r="2.5" fill="#0f6e56" opacity="0.8"/>
            
            <!-- Earbud Head Acoustic Chamber -->
            <path d="M12 28 C12 16 22 10 32 10 C42 10 48 18 48 28 C48 38 38 44 26 42 C18 40 12 36 12 28 Z" fill="url(#earbudBodyLeft)"/>
            
            <!-- Silicon Tip Angled -->
            <path d="M38 16 C44 14 54 18 54 26 C54 34 44 38 38 36 Z" fill="url(#earbudTipGrad)"/>
            <ellipse cx="44" cy="26" rx="4" ry="7" fill="#005440" opacity="0.3"/>
            
            <!-- Sleek Metallic Touch Sensor Pill -->
            <rect x="17" y="46" width="3.5" height="12" rx="1.75" fill="#0f6e56" opacity="0.75"/>
            <!-- Acoustic Mesh Vent -->
            <ellipse cx="28" cy="22" rx="2" ry="3.5" fill="#334155" opacity="0.7"/>
          </g>

          <!-- RIGHT EARBUD -->
          <g transform="translate(74, 22) rotate(8 30 45)" filter="url(#earbudShadow)">
            <!-- Stem -->
            <path d="M34 38 C34 38 33 68 32 78 C31.5 82 35 85 39 85 C43 85 46 82 45.5 78 C44.5 68 42 38 42 38 Z" fill="url(#earbudStemGlow)"/>
            <circle cx="39" cy="81" r="2.5" fill="#0f6e56" opacity="0.8"/>
            
            <!-- Earbud Head Acoustic Chamber -->
            <path d="M48 28 C48 16 38 10 28 10 C18 10 12 18 12 28 C12 38 22 44 34 42 C42 40 48 36 48 28 Z" fill="url(#earbudBodyRight)"/>
            
            <!-- Silicon Tip Angled -->
            <path d="M22 16 C16 14 6 18 6 26 C6 34 16 38 22 36 Z" fill="url(#earbudTipGrad)"/>
            <ellipse cx="16" cy="26" rx="4" ry="7" fill="#005440" opacity="0.3"/>
            
            <!-- Sleek Metallic Touch Sensor Pill -->
            <rect x="39.5" y="46" width="3.5" height="12" rx="1.75" fill="#0f6e56" opacity="0.75"/>
            <!-- Acoustic Mesh Vent -->
            <ellipse cx="32" cy="22" rx="2" ry="3.5" fill="#334155" opacity="0.7"/>
          </g>
        </svg>
      </div>
    </div>

    <!-- Calm Prominent Instruction Message -->
    <div class="focus-intro-message space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md hairline text-primary-fixed text-xs font-semibold">
        <span class="w-2 h-2 rounded-full bg-primary-fixed animate-pulse"></span>
        <span>Serene Audio Environment</span>
      </div>
      <h2 class="font-editorial text-2xl sm:text-3xl text-white font-normal leading-snug tracking-tight max-w-md">
        “Keep your earphones on for a better experience and close your eyes.”
      </h2>
      <p class="text-xs text-neutral-300 font-sans tracking-wide">
        Settling into quiet focus and restorative stillness...
      </p>
    </div>

  </div>

  <!-- Stage 2: Centered Countdown (3 → 2 → 1) -->
  <div class="focus-countdown-box">
    <div class="countdown-digit-wrapper">
      <span id="countdown-num-3" class="countdown-digit">3</span>
      <span id="countdown-num-2" class="countdown-digit">2</span>
      <span id="countdown-num-1" class="countdown-digit">1</span>
    </div>
    <p class="countdown-subtext">Arriving in stillness</p>
  </div>
</div>

<div id="drawer-backdrop" class="drawer-backdrop" onclick="closeBuildRitualDrawer()"></div>
<div id="build-ritual-drawer" class="drawer-sheet hairline-t" role="dialog" aria-labelledby="drawer-title" aria-modal="true">
  <div class="w-full flex items-center justify-center pt-3 pb-1">
    <div class="w-12 h-1.5 rounded-full bg-surface-container-high"></div>
  </div>
  <div class="p-6 overflow-y-auto max-h-[calc(88vh-2rem)]">
    <div class="flex items-start justify-between mb-4">
      <div>
        <span class="text-[11px] uppercase tracking-wider text-primary font-medium block mb-0.5">Personalized suggestions</span>
        <h2 id="drawer-title" class="font-editorial text-2xl font-normal text-on-surface">Suggested for your rhythm</h2>
        <p id="drawer-sub" class="text-xs text-outline mt-0.5">Based on your focus and gentle daily intentions.</p>
      </div>
      <button onclick="closeBuildRitualDrawer()" class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-outline hover:text-on-surface cursor-pointer border-0" aria-label="Close drawer">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <!-- Suggestions List -->
    <div class="flex flex-col gap-3 mb-6" id="drawer-suggestions-list"></div>

    <div class="flex flex-col items-center gap-2 pt-2 border-t border-surface-container">
      <button onclick="closeBuildRitualDrawer(); navigate('rituals');" class="w-full py-3 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface text-xs font-medium transition-colors flex items-center justify-center gap-2 cursor-pointer border-0">
        <span class="material-symbols-outlined text-[16px]">library_books</span>
        <span>See all suggestions &amp; full library</span>
      </button>
      <span class="text-[11px] text-outline italic">Explore practices across all mindful categories</span>
    </div>
  </div>
</div>


<!-- 1.5 ⭐ HABIT ACTION INTERACTION MENU / POPOVER ⭐ -->
<div id="habit-action-backdrop" class="drawer-backdrop" onclick="closeHabitActionPopover()"></div>

<!-- ─────────────────────────────────────────────────────── -->
<!-- MODAL: FIREBASE CONFIGURATION & CLOUD SYNC SETTINGS     -->
<!-- ─────────────────────────────────────────────────────── -->
<div id="modal-firebase-config" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/60 backdrop-blur-sm transition-opacity duration-200">
  <div class="relative w-full max-w-lg bg-surface-container-lowest rounded-3xl p-6 sm:p-8 shadow-2xl hairline max-h-[90vh] overflow-y-auto">
    
    <!-- Close Button -->
    <button type="button" onclick="closeFirebaseConfigModal()" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-surface-container hover:bg-surface-container-high flex items-center justify-center text-outline hover:text-on-surface transition-colors cursor-pointer border-0">
      <span class="material-symbols-outlined text-[18px]">close</span>
    </button>

    <!-- Header -->
    <div class="flex items-center gap-3 mb-4">
      <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center shrink-0 shadow-xs">
        <span class="material-symbols-outlined text-[24px]">local_fire_department</span>
      </div>
      <div>
        <h3 class="font-headline-md text-xl font-bold text-on-surface">Firebase Cloud Sync</h3>
        <p class="text-xs text-on-surface-variant">Connect your Firebase Authentication &amp; Firestore Database</p>
      </div>
    </div>

    <!-- Live Status Banner -->
    <div id="firebase-status-banner" class="mb-5 p-3.5 rounded-2xl bg-surface-container flex items-center justify-between border border-outline-variant/30">
      <div class="flex items-center gap-2.5">
        <span id="firebase-status-dot" class="w-3 h-3 rounded-full bg-amber-500"></span>
        <div>
          <span id="firebase-status-text" class="text-xs font-semibold text-on-surface">Local Storage Mode</span>
          <p id="firebase-status-sub" class="text-[10px] text-on-surface-variant">Paste your config below to connect Firestore</p>
        </div>
      </div>
      <button type="button" onclick="testFirebaseConnection()" class="px-3 py-1.5 rounded-xl bg-surface-container-high hover:bg-surface-variant text-xs font-medium text-on-surface transition-colors cursor-pointer border-0">
        Test Sync
      </button>
    </div>

    <!-- Quick instructions -->
    <div class="mb-5 p-3.5 rounded-2xl bg-primary-fixed/30 border border-primary-fixed-dim/40 text-xs text-on-surface space-y-1.5">
      <div class="font-semibold text-primary flex items-center gap-1.5">
        <span class="material-symbols-outlined text-[16px]">help_outline</span>
        <span>How to get your Firebase Config:</span>
      </div>
      <ol class="list-decimal list-inside text-[11px] text-on-surface-variant space-y-1 leading-relaxed pl-1">
        <li>Open <strong class="text-on-surface">Firebase Console</strong> → Click ⚙️ (Project settings).</li>
        <li>Under <strong>Your apps</strong>, select or add a <strong>Web App (&lt;/&gt;)</strong>.</li>
        <li>Copy the <code class="bg-surface-container px-1 py-0.5 rounded text-primary font-mono text-[10px]">firebaseConfig</code> snippet and paste it below.</li>
        <li>Make sure Firestore is in <strong>Test mode</strong> and Auth has <strong>Email/Password</strong> or <strong>Anonymous</strong> enabled!</li>
      </ol>
    </div>

    <!-- Config Input Form -->
    <form onsubmit="handleSaveFirebaseConfig(event)" class="space-y-4">
      <div>
        <label for="fb-raw-config" class="block text-xs font-medium text-on-surface-variant mb-1">
          Paste Firebase Config (JSON or JS snippet):
        </label>
        <textarea id="fb-raw-config" rows="6" placeholder='const firebaseConfig = {&#10;  apiKey: "AIzaSy...",&#10;  authDomain: "your-app.firebaseapp.com",&#10;  projectId: "your-app-id",&#10;  storageBucket: "your-app.appspot.com",&#10;  messagingSenderId: "123456789",&#10;  appId: "1:123456789:web:abcdef"&#10;};' class="w-full p-3 font-mono text-[11px] rounded-xl bg-surface-container-lowest hairline text-on-surface placeholder:text-outline/40 focus:outline-none focus:ring-1 focus:ring-primary-container leading-relaxed"></textarea>
      </div>

      <div class="flex items-center justify-between gap-3 pt-2">
        <button type="button" onclick="clearFirebaseConfig()" class="px-4 py-2.5 rounded-xl bg-surface-container hover:bg-error/10 hover:text-error text-xs font-medium text-on-surface-variant transition-colors cursor-pointer border-0">
          Reset to Local Only
        </button>
        <div class="flex items-center gap-2">
          <button type="button" onclick="closeFirebaseConfigModal()" class="px-4 py-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-xs font-medium text-on-surface transition-colors cursor-pointer border-0">
            Cancel
          </button>
          <button type="submit" class="px-5 py-2.5 rounded-xl bg-primary-container hover:bg-primary text-on-primary text-xs font-semibold shadow-xs transition-colors cursor-pointer border-0 flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">cloud_sync</span>
            <span>Save &amp; Connect</span>
          </button>
        </div>
      </div>
    </form>

  </div>
</div>

<div id="habit-action-popover" class="drawer-sheet hairline-t !max-w-sm mx-auto" role="dialog" aria-labelledby="ha-title" aria-modal="true">
  <div class="w-full flex items-center justify-center pt-3 pb-1">
    <div class="w-12 h-1.5 rounded-full bg-surface-container-high"></div>
  </div>
  <div class="p-6">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2.5 min-w-0">
        <div id="ha-icon-wrap" class="w-10 h-10 rounded-xl bg-primary-container/40 text-primary flex items-center justify-center shrink-0">
          <span id="ha-icon" class="material-symbols-outlined text-[22px]">spa</span>
        </div>
        <div class="min-w-0">
          <h3 id="ha-title" class="font-headline-sm text-base font-semibold text-on-surface truncate">Habit Name</h3>
          <p id="ha-subtitle" class="text-xs text-outline truncate">Daily ritual practice</p>
        </div>
      </div>
      <button onclick="closeHabitActionPopover()" class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-outline hover:text-on-surface cursor-pointer border-0" aria-label="Close menu">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <!-- Options Stack -->
    <div class="space-y-2 mb-4">
      <!-- Option 1: Complete -->
      <button type="button" onclick="confirmHabitAction('complete')" class="w-full p-3.5 rounded-2xl bg-primary/10 hover:bg-primary/15 border border-primary/20 flex items-center justify-between transition-all cursor-pointer group text-left">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-xl bg-primary text-on-primary flex items-center justify-center shrink-0 shadow-xs">
            <span class="material-symbols-outlined text-[18px]">check</span>
          </div>
          <div>
            <span class="text-sm font-semibold text-primary block">Mark as Complete</span>
            <span class="text-[11px] text-primary/80">+25 pts · Record practice for today</span>
          </div>
        </div>
        <span class="material-symbols-outlined text-[18px] text-primary opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">chevron_right</span>
      </button>

      <!-- Option 2: Skip / Rest Day -->
      <button type="button" onclick="confirmHabitAction('skip')" class="w-full p-3.5 rounded-2xl bg-surface-container-low hover:bg-surface-container hairline flex items-center justify-between transition-all cursor-pointer group text-left">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-xl bg-amber-500/10 text-amber-700 flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[18px]">snooze</span>
          </div>
          <div>
            <span class="text-sm font-semibold text-on-surface block">Skip for Today</span>
            <span class="text-[11px] text-outline">Rest day · Safeguard mindful rhythm</span>
          </div>
        </div>
        <span class="material-symbols-outlined text-[18px] text-outline opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">chevron_right</span>
      </button>

      <!-- Option 3: Mark Incomplete -->
      <button type="button" id="ha-reset-btn" onclick="confirmHabitAction('incomplete')" class="w-full p-3.5 rounded-2xl bg-surface-container-low hover:bg-surface-container hairline flex items-center justify-between transition-all cursor-pointer group text-left">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-xl bg-surface-container text-on-surface-variant flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[18px]">restart_alt</span>
          </div>
          <div>
            <span class="text-sm font-semibold text-on-surface block">Mark Incomplete</span>
            <span class="text-[11px] text-outline">Reset back to pending</span>
          </div>
        </div>
        <span class="material-symbols-outlined text-[18px] text-outline opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">chevron_right</span>
      </button>
    </div>

    <!-- Cancel Button -->
    <button type="button" onclick="closeHabitActionPopover()" class="w-full py-3 rounded-full bg-surface-container hover:bg-surface-container-high text-on-surface text-xs font-semibold transition-all hairline cursor-pointer border-0">
      Cancel
    </button>
  </div>
</div>


<!-- 2. CUSTOMIZABLE HABIT CREATOR / EDITOR MODAL -->
<div id="custom-habit-backdrop" class="drawer-backdrop" onclick="closeCustomHabitModal()"></div>
<div id="custom-habit-modal" class="drawer-sheet hairline-t !max-w-md mx-auto" role="dialog" aria-labelledby="custom-habit-title" aria-modal="true">
  <div class="w-full flex items-center justify-center pt-3 pb-1">
    <div class="w-12 h-1.5 rounded-full bg-surface-container-high"></div>
  </div>
  <div class="p-6 overflow-y-auto max-h-[calc(90vh-2rem)]">
    <div class="flex items-start justify-between mb-5">
      <div>
        <span class="text-[11px] uppercase tracking-wider text-primary font-medium block mb-0.5">Personalize Your Practice</span>
        <h2 id="custom-habit-title" class="font-editorial text-2xl font-normal text-on-surface">Add a ritual</h2>
        <p id="custom-habit-subtext" class="text-xs text-outline mt-0.5">Create or modify a gentle, recurring habit tailored to your life.</p>
      </div>
      <button onclick="closeCustomHabitModal()" class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-outline hover:text-on-surface cursor-pointer border-0" aria-label="Close custom habit creator">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <!-- Habit Form Fields -->
    <div class="space-y-4">
      <div>
        <label for="new-habit-title" class="block text-xs font-semibold text-on-surface mb-1.5">Ritual Name</label>
        <input type="text" id="new-habit-title" placeholder="e.g. 10-Minute Morning Stretch" class="w-full px-4 py-3 rounded-xl bg-surface-container-lowest hairline text-sm text-on-surface placeholder:text-outline focus:outline-none focus:ring-1 focus:ring-primary font-medium">
      </div>

      <div>
        <label for="new-habit-cue" class="block text-xs font-semibold text-on-surface mb-1.5">Gentle Anchor Cue</label>
        <input type="text" id="new-habit-cue" placeholder="e.g. right after morning kettle boils" class="w-full px-4 py-3 rounded-xl bg-surface-container-lowest hairline text-sm text-on-surface placeholder:text-outline focus:outline-none focus:ring-1 focus:ring-primary">
      </div>

      <!-- Category Selector -->
      <div>
        <label class="block text-xs font-semibold text-on-surface mb-1.5">Category</label>
        <div class="grid grid-cols-4 gap-2" id="habit-category-picker">
          <button type="button" onclick="selectHabitCategory('Health', this)" class="habit-cat-btn px-3 py-2 rounded-xl bg-primary text-on-primary text-xs font-medium cursor-pointer border-0">Health</button>
          <button type="button" onclick="selectHabitCategory('Mind', this)" class="habit-cat-btn px-3 py-2 rounded-xl bg-surface-container text-on-surface-variant text-xs font-medium cursor-pointer border-0">Mind</button>
          <button type="button" onclick="selectHabitCategory('Focus', this)" class="habit-cat-btn px-3 py-2 rounded-xl bg-surface-container text-on-surface-variant text-xs font-medium cursor-pointer border-0">Focus</button>
          <button type="button" onclick="selectHabitCategory('Craft', this)" class="habit-cat-btn px-3 py-2 rounded-xl bg-surface-container text-on-surface-variant text-xs font-medium cursor-pointer border-0">Craft</button>
        </div>
      </div>

      <!-- Icon Picker -->
      <div>
        <label class="block text-xs font-semibold text-on-surface mb-1.5">Selected Icon</label>
        <div class="flex items-center gap-2 overflow-x-auto py-1 no-scrollbar" id="habit-icon-picker">
          <button type="button" onclick="selectHabitIcon('spa', this)" class="icon-option w-10 h-10 rounded-xl bg-primary text-on-primary flex items-center justify-center cursor-pointer border-0 shrink-0"><span class="material-symbols-outlined text-[20px]">spa</span></button>
          <button type="button" onclick="selectHabitIcon('fitness_center', this)" class="icon-option w-10 h-10 rounded-xl bg-surface-container text-on-surface flex items-center justify-center cursor-pointer border-0 shrink-0"><span class="material-symbols-outlined text-[20px]">fitness_center</span></button>
          <button type="button" onclick="selectHabitIcon('water_drop', this)" class="icon-option w-10 h-10 rounded-xl bg-surface-container text-on-surface flex items-center justify-center cursor-pointer border-0 shrink-0"><span class="material-symbols-outlined text-[20px]">water_drop</span></button>
          <button type="button" onclick="selectHabitIcon('air', this)" class="icon-option w-10 h-10 rounded-xl bg-surface-container text-on-surface flex items-center justify-center cursor-pointer border-0 shrink-0"><span class="material-symbols-outlined text-[20px]">air</span></button>
          <button type="button" onclick="selectHabitIcon('timer', this)" class="icon-option w-10 h-10 rounded-xl bg-surface-container text-on-surface flex items-center justify-center cursor-pointer border-0 shrink-0"><span class="material-symbols-outlined text-[20px]">timer</span></button>
          <button type="button" onclick="selectHabitIcon('auto_stories', this)" class="icon-option w-10 h-10 rounded-xl bg-surface-container text-on-surface flex items-center justify-center cursor-pointer border-0 shrink-0"><span class="material-symbols-outlined text-[20px]">auto_stories</span></button>
          <button type="button" onclick="selectHabitIcon('directions_walk', this)" class="icon-option w-10 h-10 rounded-xl bg-surface-container text-on-surface flex items-center justify-center cursor-pointer border-0 shrink-0"><span class="material-symbols-outlined text-[20px]">directions_walk</span></button>
          <button type="button" onclick="selectHabitIcon('edit_note', this)" class="icon-option w-10 h-10 rounded-xl bg-surface-container text-on-surface flex items-center justify-center cursor-pointer border-0 shrink-0"><span class="material-symbols-outlined text-[20px]">edit_note</span></button>
          <button type="button" onclick="selectHabitIcon('bedtime', this)" class="icon-option w-10 h-10 rounded-xl bg-surface-container text-on-surface flex items-center justify-center cursor-pointer border-0 shrink-0"><span class="material-symbols-outlined text-[20px]">bedtime</span></button>
        </div>
      </div>

      <!-- Action Buttons: Save & Cancel -->
      <div class="grid grid-cols-2 gap-3 pt-2">
        <button type="button" onclick="closeCustomHabitModal()" class="py-3 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface text-sm font-semibold transition-all hairline cursor-pointer border-0">
          Cancel
        </button>
        <button type="button" id="custom-habit-submit-btn" onclick="submitCustomHabit()" class="py-3 rounded-xl bg-primary hover:bg-primary-container text-on-primary text-sm font-semibold transition-all shadow-xs cursor-pointer border-0">
          Add to daily rhythm
        </button>
      </div>
    </div>
  </div>
</div>

<!-- 3. ⭐ NEW: FOCUSED SESSION TIMER MODAL ⭐ -->
<div id="focus-timer-backdrop" class="drawer-backdrop" onclick="closeFocusTimer()"></div>
<div id="modal-focus-timer" class="drawer-sheet hairline-t !max-w-md mx-auto" role="dialog" aria-labelledby="focus-timer-title" aria-modal="true">
  <div class="w-full flex items-center justify-center pt-3 pb-1">
    <div class="w-12 h-1.5 rounded-full bg-surface-container-high"></div>
  </div>
  <div class="p-6 sm:p-7 text-center overflow-y-auto max-h-[calc(90vh-2rem)]">
    <!-- Header -->
    <div class="flex items-center justify-between mb-4">
      <div class="text-left">
        <span class="text-[11px] uppercase tracking-wider text-primary font-semibold block">Mindful Presence</span>
        <h2 id="focus-timer-title" class="font-editorial text-2xl font-normal text-on-surface">Focused session</h2>
      </div>
      <button onclick="closeFocusTimer()" class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-outline hover:text-on-surface cursor-pointer border-0" aria-label="Close timer">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <!-- Circular Countdown Timer (Matching Today Hero Ring Style) -->
    <div class="relative w-56 h-56 mx-auto my-4 flex items-center justify-center">
      <svg class="w-full h-full transform -rotate-90" viewBox="0 0 200 200">
        <!-- Track Ring -->
        <circle cx="100" cy="100" r="84" stroke="#eeeeed" stroke-width="8" fill="none"/>
        <!-- Animated Countdown Arc -->
        <circle id="timer-progress-ring" cx="100" cy="100" r="84" stroke="#0f6e56" stroke-width="8" fill="none"
                stroke-linecap="round" stroke-dasharray="527.79" stroke-dashoffset="0"
                class="transition-all duration-300 ease-linear"/>
      </svg>
      <!-- Center Display -->
      <div class="absolute flex flex-col items-center justify-center leading-none">
        <span id="timer-display-time" class="font-editorial text-4xl sm:text-5xl font-medium text-on-surface">25:00</span>
        <span id="timer-status-caption" class="text-xs text-outline mt-2 font-medium">Ready to begin</span>
      </div>
    </div>

    <!-- Duration Presets -->
    <div class="flex items-center justify-center gap-2 mb-4 flex-wrap">
      <button onclick="setTimerPreset(2, this)" class="timer-preset-btn px-3 py-1.5 rounded-full bg-surface-container hover:bg-surface-container-high text-xs font-medium text-on-surface transition-all cursor-pointer border-0">2 min</button>
      <button onclick="setTimerPreset(5, this)" class="timer-preset-btn px-3 py-1.5 rounded-full bg-surface-container hover:bg-surface-container-high text-xs font-medium text-on-surface transition-all cursor-pointer border-0">5 min</button>
      <button onclick="setTimerPreset(10, this)" class="timer-preset-btn px-3 py-1.5 rounded-full bg-surface-container hover:bg-surface-container-high text-xs font-medium text-on-surface transition-all cursor-pointer border-0">10 min</button>
      <button onclick="setTimerPreset(25, this)" class="timer-preset-btn px-3 py-1.5 rounded-full bg-primary text-on-primary text-xs font-semibold transition-all cursor-pointer border-0">25 min</button>
    </div>

        <!-- Ambient Soundscape Toggle & Volume Control -->
    <div class="p-3.5 rounded-2xl bg-surface-container-low hairline space-y-2.5 mb-5 text-left">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="material-symbols-outlined text-[20px] text-primary">graphic_eq</span>
          <div>
            <span class="text-xs font-semibold text-on-surface block">Ambient soundscape</span>
            <span class="text-[11px] text-on-surface-variant">432Hz calm pad &amp; alpha waves</span>
          </div>
        </div>
        <button id="soundscape-toggle-btn" onclick="toggleAmbientSoundscape()" class="px-3.5 py-1 rounded-full bg-primary text-xs font-semibold text-on-primary transition-all shadow-xs cursor-pointer border-0 flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px]">volume_up</span>
          <span>On</span>
        </button>
      </div>

      <!-- Volume Slider -->
      <div class="flex items-center gap-2.5 pt-1 border-t border-surface-container">
        <span class="material-symbols-outlined text-[16px] text-outline">volume_down</span>
        <input type="range" id="soundscape-vol-slider" min="0" max="1" step="0.05" value="0.6" oninput="setSoundscapeVolume(this.value)" class="w-full h-1.5 bg-surface-container-high rounded-lg appearance-none cursor-pointer accent-primary focus:outline-none">
        <span id="soundscape-vol-text" class="text-[11px] font-semibold text-outline w-9 text-right">60%</span>
      </div>
    </div>

    <!-- Timer Controls (Pause / Resume / Reset - No Penalty) -->
    <div class="flex items-center justify-center gap-3">
      <button id="timer-primary-btn" onclick="toggleFocusTimer()" class="px-7 py-3 rounded-full bg-primary hover:bg-primary-container text-on-primary text-sm font-semibold transition-all shadow-xs flex items-center gap-2 cursor-pointer border-0">
        <span id="timer-btn-icon" class="material-symbols-outlined text-[18px]">play_arrow</span>
        <span id="timer-btn-label">Begin Focus</span>
      </button>
      <button onclick="resetFocusTimer()" class="px-4 py-3 rounded-full bg-surface-container hover:bg-surface-container-high text-on-surface text-xs font-medium transition-all hairline flex items-center gap-1 cursor-pointer border-0">
        <span class="material-symbols-outlined text-[16px]">restart_alt</span>
        <span>Reset</span>
      </button>
    </div>
  </div>
</div>

<!-- 4. ⭐ UPGRADED: FITNESS & MOVEMENT PRACTITIONER QUICK-LOG MODAL ⭐ -->
<div id="movement-log-backdrop" class="drawer-backdrop" onclick="closeMovementLogger()"></div>
<div id="modal-movement-log" class="drawer-sheet hairline-t !max-w-lg mx-auto" role="dialog" aria-labelledby="movement-log-title" aria-modal="true">
  <div class="w-full flex items-center justify-center pt-3 pb-1">
    <div class="w-12 h-1.5 rounded-full bg-surface-container-high"></div>
  </div>
  <div class="p-5 sm:p-6 overflow-y-auto max-h-[calc(90vh-2rem)]">
    <!-- Header -->
    <div class="flex items-start justify-between mb-3">
      <div>
        <span class="text-[11px] uppercase tracking-wider text-secondary font-semibold block mb-0.5">Fitness &amp; Movement</span>
        <h2 id="movement-log-title" class="font-editorial text-2xl font-normal text-on-surface">Log movement</h2>
        <p class="text-xs text-outline mt-0.5">Fast, customizable logging with per-set precision &amp; PR tracking.</p>
      </div>
      <button onclick="closeMovementLogger()" class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-outline hover:text-on-surface cursor-pointer border-0" aria-label="Close movement logger">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <!-- Mode Switcher: 4 Tabs -->
    <div class="grid grid-cols-4 gap-1.5 p-1 rounded-2xl bg-surface-container mb-4">
      <button id="movement-tab-strength" onclick="setMovementTab('strength')" class="py-2 px-1 rounded-xl movement-tab-active text-[11px] sm:text-xs font-semibold transition-all cursor-pointer border-0 text-center truncate">
        Strength
      </button>
      <button id="movement-tab-cardio" onclick="setMovementTab('cardio')" class="py-2 px-1 rounded-xl movement-tab-inactive text-[11px] sm:text-xs font-semibold transition-all cursor-pointer border-0 text-center truncate">
        Cardio
      </button>
      <button id="movement-tab-calories" onclick="setMovementTab('calories')" class="py-2 px-1 rounded-xl movement-tab-inactive text-[11px] sm:text-xs font-semibold transition-all cursor-pointer border-0 text-center truncate">
        Calories
      </button>
      <button id="movement-tab-prs" onclick="setMovementTab('prs')" class="py-2 px-1 rounded-xl movement-tab-inactive text-[11px] sm:text-xs font-semibold transition-all cursor-pointer border-0 text-center truncate">
        PRs 🏆
      </button>
    </div>

    <!-- Tab 1: Strength Session -->
    <div id="movement-strength-panel" class="space-y-3.5">
      <!-- Repeat Last Workout Quick Card Slot -->
      <div id="movement-repeat-last-card" class="hidden"></div>

      <!-- Multi-Exercise List (Dynamic Exercise Cards with Per-Set Rows) -->
      <div id="movement-exercises-list" class="space-y-3">
        <!-- Injected dynamically by renderSessionExercises() -->
      </div>

      <!-- + Add Exercise Button -->
      <button type="button" onclick="openExercisePicker()" class="w-full py-2.5 rounded-2xl bg-surface-container-low hover:bg-surface-container hairline text-xs font-semibold text-primary flex items-center justify-center gap-1.5 transition-colors cursor-pointer border-0">
        <span class="material-symbols-outlined text-[18px]">add_circle</span>
        <span>+ Add Exercise</span>
      </button>

      <!-- Pacing Options -->
      <div class="pt-1">
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-xs font-semibold text-on-surface">Pacing</label>
          <span class="text-[11px] text-outline" id="pacing-current-label">Moderate</span>
        </div>
        <div class="flex flex-wrap gap-1.5" id="pacing-pill-group">
          <button type="button" onclick="selectMovementPacing('Slow', this)" class="movement-pill-btn">Slow</button>
          <button type="button" onclick="selectMovementPacing('Moderate', this)" class="movement-pill-btn active">Moderate</button>
          <button type="button" onclick="selectMovementPacing('Fast', this)" class="movement-pill-btn">Fast</button>
          <button type="button" onclick="selectMovementPacing('Custom', this)" class="movement-pill-btn">Custom</button>
        </div>
        <div id="pacing-custom-wrap" class="mt-2 hidden">
          <input type="text" id="movement-custom-pacing" placeholder="e.g. 3s eccentric tempo" class="w-full px-4 py-2 rounded-xl bg-surface-container-lowest hairline text-xs text-on-surface focus:outline-none focus:ring-1 focus:ring-primary">
        </div>
      </div>

      <!-- Perceived Exertion (Feel) Options -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-xs font-semibold text-on-surface">Perceived Exertion (Feel)</label>
          <span class="text-[11px] text-outline" id="feel-current-label">Comfortable</span>
        </div>
        <div class="flex flex-wrap gap-1.5" id="feel-pill-group">
          <button type="button" onclick="selectMovementFeel('Easy', this)" class="movement-pill-btn">Easy</button>
          <button type="button" onclick="selectMovementFeel('Comfortable', this)" class="movement-pill-btn active">Comfortable</button>
          <button type="button" onclick="selectMovementFeel('Challenging', this)" class="movement-pill-btn">Challenging</button>
          <button type="button" onclick="selectMovementFeel('Hard', this)" class="movement-pill-btn">Hard</button>
          <button type="button" onclick="selectMovementFeel('Custom', this)" class="movement-pill-btn">Custom</button>
        </div>
        <div id="feel-custom-wrap" class="mt-2 hidden">
          <input type="text" id="movement-custom-feel" placeholder="e.g. Strong mind-muscle connection" class="w-full px-4 py-2 rounded-xl bg-surface-container-lowest hairline text-xs text-on-surface focus:outline-none focus:ring-1 focus:ring-primary">
        </div>
      </div>

      <!-- Save Movement Session -->
      <button type="button" onclick="saveMovementSession()" class="w-full py-3.5 rounded-full bg-primary hover:bg-primary-container text-on-primary text-sm font-semibold transition-all shadow-xs cursor-pointer border-0 mt-3">
        Done &middot; Save workout session
      </button>
    </div>

    <!-- Tab 2: Cardio Quick-Log -->
    <div id="movement-cardio-panel" class="space-y-4 hidden">
      <form onsubmit="saveCardioSession(event)" class="space-y-3.5">
        <div>
          <label for="cardio-activity-select" class="block text-xs font-semibold text-on-surface mb-1">Cardio Activity</label>
          <select id="cardio-activity-select" class="w-full px-4 py-2.5 rounded-xl bg-surface-container-lowest hairline text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-primary font-medium">
            <option value="Treadmill">Treadmill</option>
            <option value="Running">Outdoor Running</option>
            <option value="Cycling">Cycling / Exercise Bike</option>
            <option value="Rowing">Rowing Machine</option>
            <option value="Swimming">Swimming</option>
            <option value="Elliptical">Elliptical</option>
            <option value="Jump Rope">Jump Rope</option>
            <option value="Walking">Brisk Walk</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="cardio-duration-input" class="block text-xs font-semibold text-on-surface mb-1">Duration (Minutes)</label>
            <input type="number" id="cardio-duration-input" value="30" min="1" max="600" required class="w-full px-4 py-2.5 rounded-xl bg-surface-container-lowest hairline text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-primary">
          </div>
          <div>
            <label for="cardio-calories-input" class="block text-xs font-semibold text-on-surface mb-1">Calories Burned (kcal)</label>
            <input type="number" id="cardio-calories-input" value="280" min="0" max="5000" class="w-full px-4 py-2.5 rounded-xl bg-surface-container-lowest hairline text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-primary">
          </div>
        </div>

        <button type="submit" class="w-full py-3.5 rounded-full bg-primary hover:bg-primary-container text-on-primary text-sm font-semibold transition-all shadow-xs cursor-pointer border-0 mt-3">
          Save cardio session
        </button>
      </form>
    </div>

    <!-- Tab 3: Calorie Intake Quick-Log -->
    <div id="movement-calories-panel" class="space-y-4 hidden">
      <form onsubmit="saveCalorieIntake(event)" class="space-y-3 p-3.5 rounded-2xl bg-surface-container-low hairline">
        <span class="text-xs font-semibold text-on-surface block mb-1">Quick-Log Meal or Snack</span>
        <div>
          <label for="calorie-food-item" class="block text-[11px] font-semibold text-on-surface-variant mb-1">Item / Meal Name</label>
          <input type="text" id="calorie-food-item" placeholder="e.g. Grilled chicken bowl, Protein shake..." required class="w-full px-3.5 py-2 rounded-xl bg-surface-container-lowest hairline text-xs text-on-surface focus:outline-none focus:ring-1 focus:ring-primary">
        </div>
        <div class="grid grid-cols-2 gap-2.5">
          <div>
            <label for="calorie-amount" class="block text-[11px] font-semibold text-on-surface-variant mb-1">Calories (kcal)</label>
            <input type="number" id="calorie-amount" placeholder="e.g. 650" min="1" max="10000" required class="w-full px-3.5 py-2 rounded-xl bg-surface-container-lowest hairline text-xs text-on-surface focus:outline-none focus:ring-1 focus:ring-primary">
          </div>
          <div>
            <label for="calorie-time" class="block text-[11px] font-semibold text-on-surface-variant mb-1">Time (Optional)</label>
            <input type="text" id="calorie-time" placeholder="e.g. 13:30" class="w-full px-3.5 py-2 rounded-xl bg-surface-container-lowest hairline text-xs text-on-surface focus:outline-none focus:ring-1 focus:ring-primary">
          </div>
        </div>
        <button type="submit" class="w-full py-2.5 rounded-xl bg-primary text-on-primary text-xs font-semibold hover:bg-primary-container transition-colors cursor-pointer border-0">
          + Add Food Log
        </button>
      </form>

      <!-- Today's Logged Meals -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-on-surface">Today's Nutrition</span>
          <span id="calorie-today-total" class="text-xs font-bold text-primary">0 kcal</span>
        </div>
        <div id="calorie-today-list" class="space-y-2 max-h-48 overflow-y-auto">
          <!-- Injected dynamically -->
        </div>
      </div>
    </div>

    <!-- Tab 4: Personal Records (PR) Viewer -->
    <div id="movement-prs-panel" class="space-y-3.5 hidden">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-on-surface">Verified Best Lifts</span>
        <span class="text-[11px] text-outline">Auto-updated on every PR</span>
      </div>

      <!-- Muscle Group Filter Chips -->
      <div class="flex flex-wrap gap-1.5" id="pr-muscle-chips">
        <button type="button" onclick="filterPRsByMuscle('all', this)" class="px-2.5 py-1 rounded-full text-xs font-semibold bg-primary text-on-primary cursor-pointer border-0">All</button>
        <button type="button" onclick="filterPRsByMuscle('chest', this)" class="px-2.5 py-1 rounded-full text-xs font-medium bg-surface-container text-on-surface-variant cursor-pointer border-0">Chest</button>
        <button type="button" onclick="filterPRsByMuscle('back', this)" class="px-2.5 py-1 rounded-full text-xs font-medium bg-surface-container text-on-surface-variant cursor-pointer border-0">Back</button>
        <button type="button" onclick="filterPRsByMuscle('legs', this)" class="px-2.5 py-1 rounded-full text-xs font-medium bg-surface-container text-on-surface-variant cursor-pointer border-0">Legs</button>
        <button type="button" onclick="filterPRsByMuscle('shoulders', this)" class="px-2.5 py-1 rounded-full text-xs font-medium bg-surface-container text-on-surface-variant cursor-pointer border-0">Shoulders</button>
        <button type="button" onclick="filterPRsByMuscle('arms', this)" class="px-2.5 py-1 rounded-full text-xs font-medium bg-surface-container text-on-surface-variant cursor-pointer border-0">Arms</button>
        <button type="button" onclick="filterPRsByMuscle('core', this)" class="px-2.5 py-1 rounded-full text-xs font-medium bg-surface-container text-on-surface-variant cursor-pointer border-0">Core</button>
      </div>

      <!-- PRs List -->
      <div id="prs-list-container" class="space-y-2 max-h-64 overflow-y-auto">
        <!-- Injected dynamically -->
      </div>
    </div>
  </div>
</div>

<!-- ⭐ SEARCHABLE EXERCISE PICKER MODAL ⭐ -->
<div id="modal-exercise-picker" class="fixed inset-0 z-[10001] bg-black/40 backdrop-blur-sm flex items-center justify-center p-4 hidden">
  <div class="bg-surface rounded-3xl w-full max-w-md p-5 shadow-2xl hairline max-h-[85vh] flex flex-col">
    <div class="flex items-center justify-between mb-3">
      <h3 class="font-editorial text-lg font-normal text-on-surface">Select Exercise</h3>
      <button type="button" onclick="closeExercisePicker()" class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-outline hover:text-on-surface cursor-pointer border-0">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <!-- Search Input -->
    <div class="relative mb-3">
      <span class="material-symbols-outlined absolute left-3 top-2.5 text-[18px] text-outline">search</span>
      <input type="text" id="exercise-picker-search" oninput="renderExercisePickerList(this.value)" placeholder="Search exercises (e.g. Bench, Squat, Curl)..." class="w-full pl-9 pr-4 py-2 rounded-xl bg-surface-container-lowest hairline text-xs text-on-surface focus:outline-none focus:ring-1 focus:ring-primary">
    </div>

    <!-- Muscle Group Filter Chips -->
    <div class="flex flex-wrap gap-1.5 mb-3" id="picker-muscle-chips">
      <button type="button" onclick="filterExercisePickerByMuscle('all', this)" class="px-2.5 py-1 rounded-full text-xs font-semibold bg-primary text-on-primary cursor-pointer border-0">All</button>
      <button type="button" onclick="filterExercisePickerByMuscle('chest', this)" class="px-2.5 py-1 rounded-full text-xs font-medium bg-surface-container text-on-surface-variant cursor-pointer border-0">Chest</button>
      <button type="button" onclick="filterExercisePickerByMuscle('back', this)" class="px-2.5 py-1 rounded-full text-xs font-medium bg-surface-container text-on-surface-variant cursor-pointer border-0">Back</button>
      <button type="button" onclick="filterExercisePickerByMuscle('legs', this)" class="px-2.5 py-1 rounded-full text-xs font-medium bg-surface-container text-on-surface-variant cursor-pointer border-0">Legs</button>
      <button type="button" onclick="filterExercisePickerByMuscle('shoulders', this)" class="px-2.5 py-1 rounded-full text-xs font-medium bg-surface-container text-on-surface-variant cursor-pointer border-0">Shoulders</button>
      <button type="button" onclick="filterExercisePickerByMuscle('arms', this)" class="px-2.5 py-1 rounded-full text-xs font-medium bg-surface-container text-on-surface-variant cursor-pointer border-0">Arms</button>
      <button type="button" onclick="filterExercisePickerByMuscle('core', this)" class="px-2.5 py-1 rounded-full text-xs font-medium bg-surface-container text-on-surface-variant cursor-pointer border-0">Core</button>
    </div>

    <!-- Items List -->
    <div id="exercise-picker-items" class="space-y-1.5 overflow-y-auto flex-1 pr-1">
      <!-- Injected dynamically -->
    </div>
  </div>
</div>

<!-- ⭐ NON-BLOCKING REST TIMER BAR ⭐ -->
<div id="movement-rest-timer-bar" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[10002] bg-surface-container-highest/95 backdrop-blur-md text-on-surface px-4 py-2.5 rounded-full shadow-lg hairline flex items-center gap-3 transition-all hidden">
  <div class="w-6 h-6 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0">
    <span class="material-symbols-outlined text-[16px] animate-spin">timelapse</span>
  </div>
  <div class="flex items-center gap-1.5 text-xs font-semibold">
    <span>Resting:</span>
    <span id="rest-timer-time" class="font-mono text-primary">1:30</span>
  </div>
  <button type="button" onclick="dismissRestTimer()" class="w-6 h-6 rounded-full bg-surface-container hover:bg-surface text-outline hover:text-on-surface flex items-center justify-center cursor-pointer border-0 p-0 ml-1" title="Dismiss Timer">
    <span class="material-symbols-outlined text-[14px]">close</span>
  </button>
</div>

<!-- 5. REFINED MILESTONE MEDAL SHARE MODAL -->
<div id="medal-share-backdrop" class="drawer-backdrop" onclick="closeShareMedalModal()"></div>
<div id="medal-share-modal" class="drawer-sheet hairline-t !bg-[#0e0f13] !text-white !max-w-lg mx-auto border-t border-white/10 shadow-2xl" role="dialog" aria-labelledby="share-modal-title" aria-modal="true">
  <div class="w-full flex items-center justify-center pt-3 pb-1">
    <div class="w-12 h-1.5 rounded-full bg-white/20"></div>
  </div>
  <div class="p-6 sm:p-7 overflow-y-auto max-h-[calc(90vh-2rem)] text-center">
    <div class="flex items-center justify-between mb-4">
      <span class="text-[11px] uppercase tracking-wider text-primary-fixed font-semibold">Milestone medal</span>
      <button onclick="closeShareMedalModal()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-neutral-400 hover:text-white cursor-pointer border-0" aria-label="Close share modal">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <!-- Presentation Card with Layered Medal Craftsmanship -->
    <div id="share-modal-card-wrap" class="p-7 rounded-2xl bg-[#14161a] border border-white/10 shadow-2xl mb-5 relative overflow-hidden">
      <div id="share-modal-ambient" class="absolute inset-0 bg-radial from-amber-500/20 via-transparent to-transparent pointer-events-none"></div>
      
      <div class="relative py-2 flex flex-col items-center justify-center">
        <!-- Physical Layered Medal Display -->
        <div id="share-modal-disc" class="medal-disc-wrapper medal-gold !w-28 !h-28 mx-auto mb-3 shadow-2xl">
          <div class="medal-brushed-overlay"></div>
          <div class="medal-specular-light"></div>
          <div id="share-modal-core" class="medal-beveled-core !w-20 !h-20">
            <span id="share-modal-icon" class="material-symbols-outlined medal-engraved-icon text-[40px]">hotel_class</span>
          </div>
        </div>
      </div>

      <div class="flex justify-center mb-2">
        <span id="share-modal-tier" class="inline-block px-3.5 py-1 rounded-full bg-amber-950 text-amber-200 text-xs font-semibold border border-amber-700/60">
          🥇 Gold · Century Tier
        </span>
      </div>

      <h3 id="share-modal-title" class="text-xl font-bold text-white mb-1.5 font-headline-md">Century Club</h3>
      <p id="share-modal-desc" class="text-xs text-neutral-300 max-w-sm mx-auto leading-relaxed mb-3">100 unbroken days of daily mindful practice.</p>

      <!-- Calm Philosophical Inscription Quote -->
      <div class="p-3 rounded-xl bg-white/5 border border-white/10 text-center max-w-xs mx-auto">
        <p id="share-modal-quote" class="font-editorial text-xs italic text-neutral-200">“Stillness carved in a hundred quiet suns.”</p>
      </div>

      <div class="flex items-center justify-center gap-1.5 text-[11px] text-neutral-400 mt-3">
        <span class="material-symbols-outlined text-[14px] text-primary-fixed">calendar_today</span>
        <span id="share-modal-date">Earned Oct 24, 2024</span>
      </div>
    </div>

    <!-- Share Action Buttons -->
    <div class="grid grid-cols-2 gap-3">
      <button onclick="copyMedalShareLink()" class="py-3 rounded-xl bg-white/10 hover:bg-white/15 text-white text-xs font-semibold flex items-center justify-center gap-1.5 transition-all border border-white/10 cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">link</span>
        <span>Copy Link</span>
      </button>
      <button onclick="triggerNativeShare()" class="py-3 rounded-xl bg-primary hover:bg-primary-container text-white text-xs font-semibold flex items-center justify-center gap-1.5 transition-all shadow-md cursor-pointer border-0">
        <span class="material-symbols-outlined text-[16px]">share</span>
        <span>Share</span>
      </button>
    </div>
  </div>
</div>

<!-- 6. EDIT PROFILE MODAL -->
<div id="edit-profile-backdrop" class="drawer-backdrop" onclick="closeEditProfileModal()"></div>
<div id="edit-profile-modal" class="drawer-sheet hairline-t !max-w-md mx-auto" role="dialog" aria-labelledby="edit-profile-title" aria-modal="true">
  <div class="w-full flex items-center justify-center pt-3 pb-1">
    <div class="w-12 h-1.5 rounded-full bg-surface-container-high"></div>
  </div>
  <div class="p-6 sm:p-7 overflow-y-auto max-h-[calc(90vh-2rem)]">
    <div class="flex items-start justify-between mb-5">
      <div>
        <span class="text-[11px] uppercase tracking-wider text-primary font-medium block mb-0.5">Identity &amp; Rhythm</span>
        <h2 id="edit-profile-title" class="font-editorial text-2xl font-normal text-on-surface">Edit Profile</h2>
        <p class="text-xs text-outline mt-0.5">Personalize your name and daily quiet reflection.</p>
      </div>
      <button onclick="closeEditProfileModal()" class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-outline hover:text-on-surface cursor-pointer border-0" aria-label="Close edit profile modal">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <div class="space-y-4">
      <div>
        <label for="edit-name-input" class="block text-xs font-semibold text-on-surface mb-1.5">Full Name</label>
        <input type="text" id="edit-name-input" value="Adithya Mamidala" class="w-full px-4 py-3 rounded-xl bg-surface-container-lowest hairline text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-primary">
      </div>

      <div>
        <label for="edit-mantra-input" class="block text-xs font-semibold text-on-surface mb-1.5">Personal Daily Mantra</label>
        <input type="text" id="edit-mantra-input" value="Slow is smooth, smooth is fast." class="w-full px-4 py-3 rounded-xl bg-surface-container-lowest hairline text-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-primary">
      </div>

      <button type="button" onclick="saveProfileEdits()" class="w-full py-3.5 rounded-full bg-primary hover:bg-primary-container text-on-primary text-sm font-semibold transition-all shadow-xs cursor-pointer border-0 mt-4">
        Save Changes
      </button>
    </div>
  </div>
</div>




  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- 10-SECOND UNDO TOAST                                                -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <div id="voice-undo-toast" role="alert" aria-live="assertive">
    <div class="p-3.5 sm:p-4 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 min-w-0">
        <span class="material-symbols-outlined text-[20px] shrink-0" style="color:var(--voice-cyan,#00d4ff);">history</span>
        <div class="min-w-0">
          <p id="voice-undo-message" class="text-xs font-medium truncate text-white">Action completed</p>
          <p class="text-[10px] text-gray-400">Changed your mind?</p>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <button type="button" onclick="MomentumVoiceAgent.performUndo()"
                class="px-3 py-1 rounded-full text-xs font-bold cursor-pointer border-0 transition-all bg-[#00d4ff] text-black">
          Undo (10s)
        </button>
        <button type="button" onclick="MomentumVoiceAgent.dismissUndo()"
                class="border-0 bg-transparent cursor-pointer p-1 text-gray-400 hover:text-white transition-colors">
          <span class="material-symbols-outlined text-[16px]">close</span>
        </button>
      </div>
    </div>
    <div style="background:rgba(255,255,255,0.08);">
      <div id="voice-undo-bar" class="undo-progress-bar"></div>
    </div>
  </div>
  <!-- Modular Application Bootstrap -->
  <script type="module" src="js/app.js?v=20260922d"></script>
</body>
</html>
