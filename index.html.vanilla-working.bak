        <div class="bg-[#f0f9f6] rounded-2xl p-space-lg shadow-sm hairline transition-all duration-300">
          <div class="flex items-start gap-space-md">
            <div class="w-11 h-11 rounded-2xl bg-primary-container/10 flex items-center justify-center shrink-0 text-primary-container mt-0.5">
              <span class="material-symbols-outlined text-[22px]">explore</span>
            </div>
            <div class="flex flex-col">
              <span class="font-label-sm text-label-sm text-primary-container font-semibold uppercase tracking-wider mb-1">Rhythm Pattern Discovered</span>
              <p class="font-body-lg text-body-lg text-on-surface leading-relaxed">
                Morning hydration and box breathing anchor your entire day. On days you complete your first two micro-habits before 9:00 AM, your custom reading and evening rituals achieve a <strong>94% completion rate</strong>.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Closing Emotional Line -->
      <section class="py-space-lg text-center flex flex-col items-center justify-center">
        <p class="font-editorial-quote text-editorial-quote italic text-on-surface max-w-xl">
          “Small, steady practices shape the person you become. Progress is woven quietly every single day.”
        </p>
      </section>
    </div>
  </div>
</div>

